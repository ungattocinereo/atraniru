[Unit]
Description=Atrani.ru Webhook Server (Ghost rebuild trigger)
After=network.target

[Service]
Type=simple
User=greg
WorkingDirectory=/srv/atraniru
EnvironmentFile=/srv/atraniru/.env
Environment=WEBHOOK_PORT=13103
ExecStart=/usr/bin/node /srv/atraniru/webhook.mjs
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=atraniru-webhook

[Install]
WantedBy=multi-user.target
