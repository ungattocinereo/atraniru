---
/*
 * CldImage — emits an <img> served via Cloudinary fetch delivery.
 *
 * Cloudinary pulls the source image from atrani.ru on first request,
 * applies f_auto / q_auto / w_<n>, and caches at the CDN edge.
 * Falls back to the local src if PUBLIC_CLOUDINARY_CLOUD_NAME
 * is missing, or if a transformed image errors in the browser.
 *
 * Usage:
 *   <CldImage src="/images/foo.webp" alt="..." width={1500} height={1072} priority />
 *   <CldImage src="/images/foo.webp" alt="..." width={800} height={600} sizes="(max-width: 768px) 100vw, 800px" />
 */
import {
  buildCloudinaryFetchUrl,
  buildCloudinarySrcSet,
  getResponsiveWidths,
} from '../lib/imageUrls.mjs';

interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  sizes?: string;
  /** Render eagerly (loading="eager"). Default: false (lazy). */
  eager?: boolean;
  /** Set fetchpriority="high". Use for the LCP image. Default: false. */
  priority?: boolean;
  /** Pass through `class` and other img attributes. */
  class?: string;
  [key: string]: unknown;
}

const {
  src,
  alt,
  width,
  height,
  sizes,
  eager = false,
  priority = false,
  class: className,
  ...rest
} = Astro.props as Props;

const cloud = import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME;

// Routing policy: photoshoot/apartment galleries and Ghost-served blog
// images stay direct from origin. Everything else goes through Cloudinary
// fetch when the cloud name is configured.
const SKIP_CLOUDINARY = ['/apartments/', '/images/photosessions/', '/blog/content/'];
const useCloud = Boolean(cloud) && !SKIP_CLOUDINARY.some((p) => src.includes(p));

const widths = getResponsiveWidths(width);
const srcset = useCloud
  ? buildCloudinarySrcSet({ src, widths, cloudName: cloud })
  : undefined;
// Fallback src — sized for the layout width, capped at 1600 to avoid
// shipping huge images to old browsers that ignore srcset.
const fallbackSrc = useCloud
  ? buildCloudinaryFetchUrl({ src, width: Math.min(width, 1600), cloudName: cloud })
  : src;
---

<img
  src={fallbackSrc}
  srcset={srcset}
  sizes={sizes ?? `${width}px`}
  width={width}
  height={height}
  alt={alt}
  loading={eager || priority ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={priority ? 'high' : undefined}
  data-origin-src={useCloud ? src : undefined}
  onerror={useCloud ? "this.onerror=null;this.removeAttribute('srcset');this.src=this.dataset.originSrc" : undefined}
  class={className}
  {...rest}
/>
