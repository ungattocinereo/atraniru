---
// Experiences component - grid of 3 experiences
const experiences = [
  {
    id: 1,
    title: "Фото прогулки",
    description: "Запечатлейте красоту Атрани",
    image: "/images/index/photoshootings.webp",
    href: "/photos"
  },
  {
    id: 2,
    title: "Лодочные туры",
    description: "Откройте скрытые бухты и гроты",
    image: "/images/index/excursion-boat.webp",
    href: "/experience#experiences"
  },
  {
    id: 3,
    title: "Эно-гастро туры на машине",
    description: "Вкус Амальфи: 3 маршрута от €280",
    image: "/images/index/excursion-by-car.webp",
    href: "/tours-car"
  }
];
---

<section class="experiences" id="experiences">
  <div class="section-header reveal">
    <p class="section-label">02 — Впечатления</p>
    <h2 class="section-title">Чем заняться</h2>
  </div>
  <div class="experiences-grid">
    {experiences.map((exp) => (
      <a href={exp.href} class="experience-tile reveal">
        <div class="experience-tile-image">
          <img src={exp.image} alt={exp.title} loading="lazy" decoding="async" />
        </div>
        <div class="experience-tile-overlay"></div>
        <div class="experience-tile-content">
          <span class="experience-tile-number">{String(exp.id).padStart(2, '0')}</span>
          <h3 class="experience-tile-title">{exp.title}</h3>
          <p class="experience-tile-text">{exp.description}</p>
        </div>
      </a>
    ))}
  </div>
</section>
