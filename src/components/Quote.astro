---
// About section - from concept-8-navy-brutalist.html
---

<section id="about" class="about">
  <div class="about-grid">
    <div class="about-image reveal">
      <img
        src="/images/founder.webp"
        alt="Наша команда"
        loading="lazy"
      />
    </div>
    <div class="about-content reveal">
      <p class="section-label">01 — О нас</p>
      <h2 class="section-title">Uè guagliò!</h2>
      <p>15 лет назад мы переехали из России в Италию. Получили образование по эногастрономии и влюбились в это место.</p>
      <blockquote class="about-quote">
        Атрани слишком мал, чтобы врать. Здесь всё настоящее.
      </blockquote>
      <p>Мы покажем вам Италию без туристической шелухи — настоящие вкусы, настоящих людей, настоящую жизнь.</p>
      <div class="newsletter-panel" data-newsletter-panel>
        <form
          class="newsletter-form"
          action="/hooks/subscribe-atrani-newsletter"
          method="post"
          data-newsletter-form
        >
          <div class="newsletter-copy">
            <p class="newsletter-kicker">Письма из Атрани</p>
            <p class="newsletter-title">Редко. По делу. С морским воздухом.</p>
          </div>
          <label class="newsletter-field">
            <span class="sr-only">Email для рассылки</span>
            <input
              type="email"
              name="email"
              placeholder="ваш email"
              autocomplete="email"
              required
            />
          </label>
          <button class="newsletter-submit" type="submit">Подписаться</button>
          <p class="newsletter-message" data-newsletter-message aria-live="polite"></p>
        </form>
        <div class="newsletter-success" data-newsletter-success aria-live="polite">
          <p class="newsletter-success-title">Спасибо что подписались на нашу рассылку.</p>
          <p>Будем присылать редкие но яркие весточки прямо из Атрани</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const newsletterForm = document.querySelector('[data-newsletter-form]');
  const newsletterPanel = document.querySelector('[data-newsletter-panel]');
  const newsletterMessage = document.querySelector('[data-newsletter-message]');

  newsletterForm?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!(newsletterForm instanceof HTMLFormElement)) return;
    const submitButton = newsletterForm.querySelector('button[type="submit"]');
    const formData = new FormData(newsletterForm);
    const email = String(formData.get('email') || '').trim();

    newsletterForm.classList.add('is-loading');
    newsletterMessage.textContent = '';
    if (submitButton instanceof HTMLButtonElement) {
      submitButton.disabled = true;
      submitButton.textContent = 'Отправляем';
    }

    try {
      const response = await fetch(newsletterForm.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email,
          page: window.location.href,
          referrer: document.referrer,
        }),
      });

      if (!response.ok) {
        throw new Error('subscribe failed');
      }

      newsletterPanel?.classList.add('is-subscribed');
      newsletterForm.reset();
    } catch {
      newsletterMessage.textContent = 'Не получилось подписать. Проверьте email и попробуйте ещё раз.';
    } finally {
      newsletterForm.classList.remove('is-loading');
      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = false;
        submitButton.textContent = 'Подписаться';
      }
    }
  });
</script>

<style>
  .about {
    background: var(--color-white);
    padding: 120px 40px;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
    max-width: 1400px;
    margin: 0 auto;
  }

  .about-image {
    position: relative;
  }

  .about-image img {
    width: 100%;
    display: block;
  }

  .about-image::after {
    content: '';
    position: absolute;
    top: 20px;
    left: 20px;
    right: -20px;
    bottom: -20px;
    border: 3px solid var(--color-orange);
    z-index: -1;
  }

  .about-content p {
    font-size: 18px;
    color: var(--color-gray-dark);
    margin-bottom: 24px;
    line-height: 1.8;
  }

  .about-quote {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 700;
    line-height: 1.3;
    margin: 40px 0;
    padding-left: 24px;
    border-left: 4px solid var(--color-orange);
    color: var(--color-navy);
  }

  .newsletter-panel {
    position: relative;
    margin-top: 36px;
    padding: 26px;
    background: var(--color-orange);
    color: var(--color-white);
    overflow: hidden;
  }

  .newsletter-panel::before {
    content: 'ATRANI';
    position: absolute;
    right: -10px;
    bottom: -24px;
    font-family: var(--font-display);
    font-size: clamp(64px, 9vw, 120px);
    font-weight: 900;
    line-height: 1;
    color: rgba(255, 255, 255, 0.12);
    pointer-events: none;
  }

  .newsletter-form {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 14px 12px;
    align-items: end;
  }

  .newsletter-copy {
    grid-column: 1 / -1;
    align-self: center;
  }

  .newsletter-kicker {
    margin: 0 0 6px !important;
    color: rgba(255, 255, 255, 0.78) !important;
    font-family: var(--font-display);
    font-size: 11px !important;
    font-weight: 700;
    letter-spacing: 2px;
    line-height: 1.2 !important;
    text-transform: uppercase;
  }

  .newsletter-title {
    margin: 0 !important;
    color: var(--color-white) !important;
    font-family: var(--font-display);
    font-size: clamp(22px, 2vw, 30px) !important;
    font-weight: 800;
    line-height: 1.12 !important;
    letter-spacing: -0.5px;
  }

  .newsletter-field {
    display: block;
  }

  .newsletter-field input {
    width: 100%;
    min-height: 54px;
    border: 2px solid rgba(255, 255, 255, 0.78);
    border-radius: 0;
    background: rgba(255, 255, 255, 0.96);
    color: var(--color-navy-deep);
    font: inherit;
    font-size: 16px;
    outline: none;
    padding: 0 16px;
    transition: border-color 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);
  }

  .newsletter-field input:focus {
    border-color: var(--color-navy-deep);
    box-shadow: 6px 6px 0 var(--color-navy-deep);
  }

  .newsletter-field input::placeholder {
    color: var(--color-gray);
  }

  .newsletter-submit {
    min-height: 54px;
    border: 2px solid var(--color-navy-deep);
    border-radius: 0;
    background: var(--color-navy-deep);
    color: var(--color-white);
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
    padding: 0 20px;
    text-transform: uppercase;
    transition: transform 0.2s var(--ease-out), background 0.2s var(--ease-out);
    white-space: nowrap;
  }

  .newsletter-submit:hover {
    background: var(--color-white);
    color: var(--color-navy-deep);
    transform: translate(-2px, -2px);
  }

  .newsletter-submit:disabled {
    cursor: wait;
    opacity: 0.72;
    transform: none;
  }

  .newsletter-message {
    grid-column: 1 / -1;
    min-height: 18px;
    margin: 0 !important;
    color: var(--color-white) !important;
    font-size: 13px !important;
    font-weight: 600;
    line-height: 1.4 !important;
  }

  .newsletter-success {
    position: relative;
    z-index: 1;
    display: none;
  }

  .newsletter-success-title {
    margin: 0 0 8px !important;
    color: var(--color-white) !important;
    font-family: var(--font-display);
    font-size: clamp(22px, 2vw, 30px) !important;
    font-weight: 900;
    line-height: 1.12 !important;
    letter-spacing: -0.5px;
  }

  .newsletter-success p:not(.newsletter-success-title) {
    margin: 0 !important;
    color: rgba(255, 255, 255, 0.88) !important;
    font-size: 16px !important;
    line-height: 1.5 !important;
  }

  .newsletter-panel.is-subscribed .newsletter-form {
    display: none;
  }

  .newsletter-panel.is-subscribed .newsletter-success {
    display: block;
    animation: newsletterIn 0.35s var(--ease-out);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @keyframes newsletterIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 1024px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .about-image::after {
      top: 10px;
      left: 10px;
      right: -10px;
      bottom: -10px;
    }
  }

  @media (max-width: 768px) {
    .about {
      padding: 80px 20px;
    }

    .about-quote {
      font-size: 24px;
      margin: 32px 0;
    }

    .newsletter-panel {
      padding: 22px;
    }

    .newsletter-form {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .newsletter-submit {
      width: 100%;
    }
  }
</style>
