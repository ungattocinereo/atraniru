---
// TelegramCoastBanner — news channel promo before the Amalfi coast editorial section
---

<section class="telegram-band" aria-label="Новости Амальфитанского побережья">
  <div class="telegram-shell reveal">
    <a
      class="telegram-banner"
      href="https://t.me/amalfinovosti"
      target="_blank"
      rel="noopener noreferrer"
    >
      <div class="telegram-banner-media" aria-hidden="true">
        <img
          src="/images/index/amalfi-telegram-news.webp"
          alt=""
          loading="lazy"
          decoding="async"
          width="1774"
          height="887"
        />
      </div>
      <div class="telegram-banner-copy">
        <div class="telegram-banner-copy-inner">
          <p class="telegram-kicker">Меж двух лимонов</p>
          <h2>Новости побережья</h2>
          <p class="telegram-text">
            Коротко о том, что происходит в Атрани, Амальфи, Равелло и рядом: море,
            дороги, события, полезные новости и настроение дня.
          </p>
          <span class="telegram-cta">Подписаться в Telegram</span>
        </div>
      </div>
    </a>
  </div>
</section>

<style>
  .telegram-band {
    padding: 104px 0 0;
    background: var(--color-white);
    color: var(--color-white);
    overflow: hidden;
  }

  .telegram-shell {
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .telegram-banner {
    position: relative;
    isolation: isolate;
    display: block;
    width: 100vw;
    max-width: 100%;
    min-height: clamp(440px, 42vw, 620px);
    overflow: hidden;
    background: var(--color-navy-deep);
    color: var(--color-white);
    text-decoration: none;
  }

  .telegram-banner::before {
    content: 'AMALFI NEWS';
    position: absolute;
    left: max(22px, calc((100vw - 1200px) / 2));
    bottom: -20px;
    z-index: 2;
    color: rgba(255, 255, 255, 0.12);
    font-family: var(--font-display);
    font-size: clamp(64px, 11vw, 168px);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 0.9;
    pointer-events: none;
  }

  .telegram-banner::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg, rgba(0, 10, 39, 0.03) 0%, rgba(0, 10, 39, 0.28) 38%, rgba(0, 10, 39, 0.88) 70%, rgba(0, 10, 39, 0.98) 100%),
      linear-gradient(180deg, rgba(255, 87, 34, 0.08), rgba(0, 10, 39, 0.16));
    pointer-events: none;
  }

  .telegram-banner-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .telegram-banner-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    transform: scale(1.01);
    transition: transform 0.7s var(--ease-out);
  }

  .telegram-banner-copy {
    position: relative;
    z-index: 2;
    display: flex;
    width: min(1200px, calc(100% - 80px));
    min-height: clamp(440px, 42vw, 620px);
    justify-content: center;
    margin: 0 auto;
  }

  .telegram-banner-copy-inner {
    width: min(540px, 42vw);
    margin-left: auto;
    padding: 54px 0 52px;
  }

  .telegram-kicker {
    margin: 0 0 14px;
    color: var(--color-orange);
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2px;
    line-height: 1;
    text-transform: uppercase;
  }

  .telegram-banner h2 {
    margin: 0;
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: clamp(42px, 4.7vw, 70px);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 0.95;
    text-wrap: balance;
    text-transform: uppercase;
  }

  .telegram-text {
    max-width: 470px;
    margin: 22px 0 28px;
    color: rgba(255, 255, 255, 0.82);
    font-size: 16px;
    line-height: 1.55;
  }

  .telegram-cta {
    display: inline-flex;
    width: fit-content;
    min-height: 52px;
    align-items: center;
    border: 2px solid var(--color-orange);
    background: var(--color-orange);
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.4px;
    padding: 0 20px;
    text-transform: uppercase;
    transition:
      background 0.2s var(--ease-out),
      color 0.2s var(--ease-out),
      transform 0.2s var(--ease-out);
  }

  .telegram-banner:hover .telegram-banner-media img {
    transform: scale(1.05);
  }

  .telegram-banner:hover .telegram-cta {
    background: var(--color-white);
    color: var(--color-navy-deep);
    transform: translate(-2px, -2px);
  }

  .telegram-banner:focus-visible {
    outline: 4px solid var(--color-orange);
    outline-offset: 6px;
  }

  @media (max-width: 900px) {
    .telegram-banner {
      min-height: 560px;
    }

    .telegram-banner::after {
      background:
        linear-gradient(180deg, rgba(0, 10, 39, 0.04) 0%, rgba(0, 10, 39, 0.18) 32%, rgba(0, 10, 39, 0.96) 100%),
        linear-gradient(180deg, rgba(255, 87, 34, 0.08), rgba(0, 10, 39, 0.08));
    }

    .telegram-banner-copy {
      width: min(100% - 56px, 720px);
      min-height: 560px;
      justify-content: flex-end;
    }

    .telegram-banner-copy-inner {
      width: 100%;
      margin-left: 0;
      padding: 34px 0 38px;
    }
  }

  @media (max-width: 760px) {
    .telegram-band {
      padding-top: 64px;
    }

    .telegram-banner {
      min-height: 520px;
    }

    .telegram-banner::before {
      left: 14px;
      bottom: -10px;
      font-size: 44px;
    }

    .telegram-banner-media img {
      object-position: 34% center;
    }

    .telegram-banner-copy {
      width: calc(100% - 44px);
      min-height: 520px;
    }

    .telegram-banner-copy-inner {
      padding: 26px 0 30px;
    }

    .telegram-banner h2 {
      font-size: clamp(34px, 10vw, 44px);
    }

    .telegram-text {
      margin: 18px 0 22px;
      font-size: 15px;
      line-height: 1.5;
    }

    .telegram-cta {
      width: 100%;
      justify-content: center;
      min-height: 54px;
      padding: 0 14px;
      text-align: center;
    }
  }
</style>
