---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import CldImage from './CldImage.astro';

interface Detail {
  title: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  intro: string;
  image: string;
  imageAlt: string;
  serviceKey: string;
  serviceName: string;
  priceLabel: string;
  details: Detail[];
  highlights: string[];
  schemaType?: 'TouristTrip' | 'Service';
  offerPrice?: string;
  imageWidth?: number;
  imageHeight?: number;
}

const {
  title,
  description,
  eyebrow,
  heading,
  intro,
  image,
  imageAlt,
  serviceKey,
  serviceName,
  priceLabel,
  details,
  highlights,
  schemaType = 'TouristTrip',
  offerPrice,
  imageWidth = 2400,
  imageHeight = 1600,
} = Astro.props;

const canonicalUrl = `https://atrani.ru${Astro.url.pathname}`;
const contactUrl = `/contacts?service=${encodeURIComponent(serviceKey)}#contact-form`;
const schema = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  '@id': `${canonicalUrl}#service`,
  name: serviceName,
  description,
  url: canonicalUrl,
  image: `https://atrani.ru${image}`,
  inLanguage: 'ru',
  areaServed: [
    { '@type': 'City', name: 'Atrani' },
    { '@type': 'City', name: 'Amalfi' },
    { '@type': 'City', name: 'Ravello' },
    { '@type': 'City', name: 'Positano' },
  ],
  provider: {
    '@type': 'TravelAgency',
    '@id': 'https://atrani.ru/#agency',
    name: 'Atrani.ru — АМАЛЬФИГЕТЬ',
    url: 'https://atrani.ru',
    telephone: '+39 327 097 2329',
  },
  ...(offerPrice ? {
    offers: {
      '@type': 'Offer',
      price: offerPrice,
      priceCurrency: 'EUR',
      availability: 'https://schema.org/InStock',
      url: contactUrl,
    },
  } : {}),
};
---

<Layout title={title} description={description} ogImage={image} ogImageAlt={imageAlt}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <Breadcrumbs items={[
    { name: 'Главная', url: '/' },
    { name: 'Экскурсии', url: '/experience' },
    { name: serviceName, url: Astro.url.pathname },
  ]} hideVisually={true} />

  <section class="tour-hero">
    <div class="tour-hero-image">
      <CldImage src={image} alt={imageAlt} width={imageWidth} height={imageHeight} sizes="100vw" priority />
    </div>
    <div class="tour-hero-overlay"></div>
    <div class="tour-hero-content">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{heading}</h1>
      <p class="intro">{intro}</p>
      <a class="btn btn-primary" href={contactUrl}>Узнать доступность</a>
    </div>
  </section>

  <section class="tour-content">
    <div class="summary">
      <p class="section-label">Необычная экскурсия от местных жителей</p>
      <h2>Что вас ждёт</h2>
      <p>{description}</p>
      <div class="price">{priceLabel}</div>
    </div>

    <div class="details-grid">
      {details.map((detail, index) => (
        <article class="detail-card">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3>{detail.title}</h3>
          <p>{detail.text}</p>
        </article>
      ))}
    </div>

    <div class="highlights">
      <h2>В маршруте</h2>
      <ul>
        {highlights.map((highlight) => <li>{highlight}</li>)}
      </ul>
    </div>

    <div class="booking">
      <div>
        <p class="section-label">Заявка без оплаты</p>
        <h2>Обсудим маршрут и даты</h2>
        <p>Оставьте контакты: форма сразу передаст нам выбранный тип экскурсии.</p>
      </div>
      <a class="btn btn-primary" href={contactUrl}>Отправить заявку</a>
    </div>
  </section>
</Layout>

<style>
  .tour-hero {
    min-height: 78vh;
    position: relative;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    color: white;
  }

  .tour-hero-image,
  .tour-hero-overlay {
    position: absolute;
    inset: 0;
  }

  .tour-hero-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tour-hero-overlay {
    background: linear-gradient(180deg, rgba(0, 10, 39, .2), rgba(0, 10, 39, .92));
  }

  .tour-hero-content {
    position: relative;
    z-index: 1;
    width: min(1200px, calc(100% - 48px));
    margin: 0 auto;
    padding: 180px 0 72px;
  }

  .eyebrow,
  .section-label {
    color: var(--color-orange);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  h1 {
    max-width: 1000px;
    margin: 16px 0 24px;
    font-family: var(--font-display);
    font-size: clamp(42px, 7vw, 104px);
    line-height: .96;
  }

  .intro {
    max-width: 720px;
    margin-bottom: 32px;
    font-size: clamp(18px, 2vw, 24px);
  }

  .tour-content {
    width: min(1200px, calc(100% - 48px));
    margin: 0 auto;
    padding: 96px 0;
  }

  .summary {
    max-width: 820px;
    margin-bottom: 64px;
  }

  h2 {
    margin: 12px 0 20px;
    font-family: var(--font-display);
    font-size: clamp(30px, 4vw, 54px);
  }

  .summary > p:last-of-type,
  .booking p {
    font-size: 18px;
    line-height: 1.7;
  }

  .price {
    display: inline-block;
    margin-top: 24px;
    padding: 12px 18px;
    background: var(--color-navy);
    color: white;
    font-weight: 800;
  }

  .details-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .detail-card {
    min-height: 240px;
    padding: 32px;
    border: 2px solid var(--color-navy);
  }

  .detail-card span {
    color: var(--color-orange);
    font-family: var(--font-display);
    font-weight: 800;
  }

  .detail-card h3 {
    margin: 40px 0 14px;
    font-family: var(--font-display);
    font-size: 22px;
  }

  .detail-card p,
  .highlights li {
    line-height: 1.65;
  }

  .highlights {
    margin: 80px 0;
    padding: 48px;
    background: #f2f3f6;
  }

  .highlights ul {
    columns: 2;
    gap: 56px;
    padding-left: 20px;
  }

  .highlights li {
    margin-bottom: 12px;
    break-inside: avoid;
  }

  .booking {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    padding: 48px;
    border: 2px solid var(--color-navy);
  }

  .booking h2 {
    margin-bottom: 10px;
  }

  @media (max-width: 800px) {
    .tour-hero-content,
    .tour-content {
      width: min(100% - 32px, 1200px);
    }

    .tour-hero-content {
      padding-bottom: 48px;
    }

    .details-grid {
      grid-template-columns: 1fr;
    }

    .highlights {
      padding: 28px;
    }

    .highlights ul {
      columns: 1;
    }

    .booking {
      align-items: flex-start;
      flex-direction: column;
      padding: 28px;
    }
  }
</style>
