---
import Layout from './Layout.astro';
import { rewriteGhostUrl } from '../lib/ghost';
import { createMetaDescription } from '../lib/seo.mjs';
import type { GhostPost } from '../lib/types/ghost';

interface Props {
  post: GhostPost;
}

const { post } = Astro.props;

const siteUrl = 'https://atrani.ru';
const canonicalUrl = `${siteUrl}/blog/${post.slug}`;

// Title: Ghost og_title > meta_title > default
const metaTitle = post.og_title || post.meta_title || `${post.title} — Atrani.ru`;

// Always provide a useful description, including legacy Ghost posts without metadata.
const metaDescription = createMetaDescription(post);

// OG image
const ogImage = rewriteGhostUrl(post.og_image || post.feature_image) || '/meta.png';
const schemaImage = new URL(ogImage, siteUrl).href;

// Twitter-specific overrides (Ghost allows separate twitter fields)
const twitterTitle = post.twitter_title || metaTitle;
const twitterDescription = post.twitter_description || metaDescription;
const twitterImage = rewriteGhostUrl(post.twitter_image || post.og_image || post.feature_image) || '/meta.png';

// Author twitter handle
const authorTwitter = post.primary_author?.twitter
  ? (post.primary_author.twitter.startsWith('@') ? post.primary_author.twitter : `@${post.primary_author.twitter}`)
  : undefined;
const authorWebsite = post.primary_author?.website
  ? post.primary_author.website.replace(/^http:\/\/www\.cinereo\.it\/?$/i, 'https://cinereo.it')
  : undefined;

// Image alt text
const imageAlt = post.feature_image_alt || post.title;

// Word count for JSON-LD
const wordCount = post.html
  ? post.html.replace(/<[^>]*>/g, '').trim().split(/\s+/).length
  : undefined;

// Article section from primary tag
const articleSection = post.primary_tag?.name || undefined;

// Keywords from all tags (CSV string per schema.org spec)
const keywords = post.tags && post.tags.length > 0
  ? post.tags.map((t) => t.name).join(', ')
  : undefined;
---

<Layout
  title={metaTitle}
  description={metaDescription}
  ogImage={ogImage}
  ogType="article"
  ogImageAlt={imageAlt}
  twitterSite="@atraniru"
  twitterCreator={authorTwitter}
  twitterTitle={twitterTitle}
  twitterDescription={twitterDescription}
  twitterImage={twitterImage}
>
  <!-- Reading progress bar -->
  <div class="reading-progress" id="progress"></div>

  <slot />

  <!-- Open Graph meta tags for blog posts -->
  {post.published_at && (
    <meta slot="head" property="article:published_time" content={post.published_at} />
  )}
  {post.updated_at && (
    <meta slot="head" property="article:modified_time" content={post.updated_at} />
  )}
  {post.primary_author && (
    <meta slot="head" property="article:author" content={post.primary_author.name} />
  )}
  {post.tags && post.tags.map((tag) => (
    <meta slot="head" property="article:tag" content={tag.name} />
  ))}

  <!-- JSON-LD Structured Data -->
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.title,
    "description": metaDescription,
    "image": schemaImage,
    "datePublished": post.published_at,
    "dateModified": post.updated_at,
    "inLanguage": "ru",
    ...(wordCount ? { "wordCount": wordCount } : {}),
    ...(articleSection ? { "articleSection": articleSection } : {}),
    ...(keywords ? { "keywords": keywords } : {}),
    "author": post.primary_author ? {
      "@type": "Person",
      "name": post.primary_author.name,
      "image": rewriteGhostUrl(post.primary_author.profile_image),
      "description": post.primary_author.bio,
      ...(authorWebsite ? { "url": authorWebsite } : {})
    } : undefined,
    "publisher": {
      "@type": "Organization",
      "name": "Atrani.ru",
      "url": "https://atrani.ru",
      "logo": {
        "@type": "ImageObject",
        "url": "https://atrani.ru/icon-512.png",
        "width": 512,
        "height": 512
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": canonicalUrl
    }
  })}></script>
</Layout>

<style is:global>
  @import '../styles/blog.css';
</style>

<script>
  // Reading progress bar
  const progressBar = document.getElementById('progress');
  if (progressBar) {
    window.addEventListener('scroll', () => {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = (scrollTop / docHeight) * 100;
      progressBar.style.width = progress + '%';
    });
  }

  // Reveal on scroll
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

  // Smooth scroll for anchor links
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      const target = document.querySelector(this.getAttribute('href') as string);
      if (target) {
        target.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });
</script>
