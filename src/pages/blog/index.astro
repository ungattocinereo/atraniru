---
import Layout from '../../layouts/Layout.astro';
import { getAllPosts, getFeaturedPosts, formatDate } from '../../lib/ghostApi';
import { rewriteGhostUrl } from '../../lib/ghost';

const [allPosts, featuredPosts] = await Promise.all([
  getAllPosts({ limit: 'all' }),
  getFeaturedPosts(4),
]);

const BATCH_SIZE = 12;

// Category counts for toggle badges
const blogCount = allPosts.filter(p => p.primary_tag?.slug === 'blogh').length;
const newsCount = allPosts.filter(p => p.primary_tag?.slug === 'novosti').length;

// Exclude featured from regular grid
const featuredIds = new Set(featuredPosts.map(p => p.id));
const regularPosts = allPosts.filter(p => !featuredIds.has(p.id));
---

<Layout
  title="Блог об Амальфитанском побережье — новости и советы от местных | Atrani.ru"
  description="Свежие статьи от тех, кто живёт на Амальфитанском побережье прямо сейчас. Маршруты, секретные места, гастрономия, практические советы — настоящая Италия без туристической шелухи."
  ogImage="/images/index/atrani-4-index.jpg"
  ogImageWidth={2500}
  ogImageHeight={1667}
  ogImageAlt="Блог Atrani.ru — жизнь на Амальфитанском побережье"
  twitterSite="@atraniru"
>
  <section class="blog-hero">
    <!-- Background decorative text -->
    <div class="blog-hero-bg-text" aria-hidden="true">БЛОЖЕ</div>

    <!-- Hero background image -->
    <div class="blog-hero-bg-image">
      <img
        src="/images/index/atrani-4-index.jpg"
        alt="Атрани — вид на город у моря"
        loading="eager"
      />
    </div>

    <!-- Overlay for text readability -->
    <div class="blog-hero-overlay"></div>

    <!-- Hero content -->
    <div class="blog-hero-content">
      <p class="hero-label">Блог</p>
      <h1 class="blog-hero-title">
        <span class="highlight">ЖИЗНЬ</span>
        <span class="blog-hero-title-line">У МОРЮШКА</span>
      </h1>
      <p class="blog-hero-subtitle">Свежие статьи от местных жителей побережья Амальфи — маршруты, секреты, гастрономия и советы из первых рук</p>
    </div>

    <!-- Scroll indicator -->
    <div class="scroll-indicator" aria-hidden="true">Scroll</div>
  </section>

  <!-- Category toggles -->
  <section class="blog-filters">
    <div class="blog-filters-inner">
      <button class="blog-filter-tab is-active" data-filter="all" type="button">
        Все посты
        <span class="blog-filter-count">{allPosts.length}</span>
      </button>
      <button class="blog-filter-tab" data-filter="blogh" type="button">
        Блог
        <span class="blog-filter-count">{blogCount}</span>
      </button>
      <button class="blog-filter-tab" data-filter="novosti" type="button">
        Новости
        <span class="blog-filter-count">{newsCount}</span>
      </button>
    </div>
  </section>

  <!-- Featured posts -->
  {featuredPosts.length > 0 && (
    <section class="featured-section">
      <div class="featured-header">
        <span class="featured-label">Избранное</span>
        <div class="featured-line" aria-hidden="true"></div>
      </div>
      <div class="featured-grid">
        {featuredPosts.map((post, i) => (
          <article
            class={`featured-card ${i === 0 ? 'featured-card--hero' : 'featured-card--small'} reveal`}
            data-tag={post.primary_tag?.slug || ''}
          >
            <a href={`/blog/${post.slug}`}>
              <div class="featured-card-image">
                <img
                  src={rewriteGhostUrl(post.feature_image) || '/images/placeholder-blog.jpg'}
                  alt={post.title}
                  loading="eager"
                />
                <div class="featured-card-overlay"></div>
                <span class="featured-card-badge">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  Избранное
                </span>
              </div>
              <div class="featured-card-content">
                {post.primary_tag && (
                  <span class="featured-card-category">{post.primary_tag.name}</span>
                )}
                <h2 class="featured-card-title">{post.title}</h2>
                {i === 0 && (
                  <p class="featured-card-excerpt">{post.custom_excerpt || post.excerpt}</p>
                )}
                <div class="featured-card-meta">
                  <time datetime={post.published_at}>{formatDate(post.published_at)}</time>
                  <span>{post.reading_time} мин</span>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="blog-listing">
    <div class="section-divider">
      <span class="section-divider-label">Последние публикации</span>
      <div class="section-divider-line" aria-hidden="true"></div>
    </div>
    <div class="blog-listing-grid" data-batch-size={BATCH_SIZE}>
      {regularPosts.map((post, i) => (
        <article
          class={`blog-listing-card reveal ${i >= BATCH_SIZE ? 'blog-listing-card--hidden' : ''}`}
          data-index={i}
          data-tag={post.primary_tag?.slug || ''}
        >
          <a href={`/blog/${post.slug}`}>
            <div class="blog-listing-card-image">
              <img
                src={rewriteGhostUrl(post.feature_image) || '/images/placeholder-blog.jpg'}
                alt={post.title}
                loading={i < 3 ? 'eager' : 'lazy'}
              />
              {post.primary_tag && (
                <span class="blog-listing-card-category">{post.primary_tag.name}</span>
              )}
            </div>
            <div class="blog-listing-card-content">
              <h2 class="blog-listing-card-title">{post.title}</h2>
              <p class="blog-listing-card-excerpt">{post.custom_excerpt || post.excerpt}</p>
              <div class="blog-listing-card-meta">
                {post.primary_author && (
                  <span class="blog-listing-card-author">
                    {post.primary_author.profile_image && (
                      <img src={rewriteGhostUrl(post.primary_author.profile_image)} alt={post.primary_author.name} class="blog-listing-card-author-img" />
                    )}
                    {post.primary_author.name}
                  </span>
                )}
                <time datetime={post.published_at}>{formatDate(post.published_at)}</time>
                <span>{post.reading_time} мин</span>
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>

    {regularPosts.length > BATCH_SIZE && (
      <div id="load-more-sentinel" aria-hidden="true"></div>
    )}

    {regularPosts.length === 0 && (
      <div class="blog-empty">
        <p>Статьи скоро появятся. Следите за обновлениями!</p>
      </div>
    )}
  </section>

  <section class="newsletter">
    <div class="newsletter-bg-text" aria-hidden="true">ПОЧТА</div>
    <div class="newsletter-content">
      <h2 class="newsletter-title">Италия в вашей почте</h2>
      <p class="newsletter-text">Раз в неделю — новые маршруты, секретные места и истории из жизни на побережье. Без спама, только полезное.</p>
      <form class="newsletter-form">
        <input type="email" class="newsletter-input" placeholder="Ваш email" required />
        <button type="submit" class="newsletter-btn">Подписаться</button>
      </form>
    </div>
  </section>

  <!-- JSON-LD Blog schema -->
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Blog",
    "name": "Блог Atrani.ru — Амальфитанское побережье",
    "description": "Свежие статьи от тех, кто живёт на Амальфитанском побережье прямо сейчас.",
    "url": "https://atrani.ru/blog",
    "inLanguage": "ru",
    "publisher": {
      "@type": "Organization",
      "name": "Atrani.ru",
      "url": "https://atrani.ru",
      "logo": {
        "@type": "ImageObject",
        "url": "https://atrani.ru/logo.png"
      }
    },
    "blogPost": allPosts.slice(0, 10).map(post => ({
      "@type": "BlogPosting",
      "headline": post.title,
      "url": `https://atrani.ru/blog/${post.slug}`,
      "datePublished": post.published_at,
      "image": rewriteGhostUrl(post.feature_image),
      ...(post.primary_author ? { "author": { "@type": "Person", "name": post.primary_author.name } } : {})
    }))
  })}></script>
</Layout>

<style is:global>
  @import '../../styles/blog.css';
</style>

<style>
  /* =============================================
     HERO
     ============================================= */
  .blog-hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    background: var(--color-navy-deep);
    color: white;
    overflow: hidden;
    padding: 120px 40px 80px;
  }

  .blog-hero-bg-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-display);
    font-size: clamp(128px, 21vw, 340px);
    font-weight: 900;
    color: rgba(255, 255, 255, 0.03);
    pointer-events: none;
    user-select: none;
    z-index: 2;
    white-space: nowrap;
  }

  .blog-hero-bg-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    opacity: 0;
    animation: fadeIn 1.2s var(--ease-out) 0.6s forwards;
  }

  .blog-hero-bg-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .blog-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(0, 10, 39, 0.88) 0%,
      rgba(0, 10, 39, 0.7) 50%,
      rgba(0, 10, 39, 0.5) 100%
    );
    z-index: 0;
  }

  .blog-hero-content {
    position: relative;
    z-index: 3;
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
  }

  .blog-hero-title {
    font-family: var(--font-display);
    font-size: clamp(48px, 10vw, 160px);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -4px;
    margin-bottom: 32px;
    opacity: 0;
    animation: fadeInUp 0.8s var(--ease-out) 0.3s forwards;
  }

  .blog-hero-title .highlight {
    display: block;
    color: var(--color-orange);
  }

  .blog-hero-title-line {
    white-space: nowrap;
  }

  .blog-hero-subtitle {
    font-size: clamp(18px, 2vw, 24px);
    color: var(--color-gray);
    max-width: 600px;
    margin-bottom: 40px;
    opacity: 0;
    animation: fadeInUp 0.8s var(--ease-out) 0.4s forwards;
  }

  /* =============================================
     CATEGORY FILTER TABS
     ============================================= */
  .blog-filters {
    background: white;
    padding: 40px 40px;
  }

  .blog-filters-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .blog-filter-tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 28px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--color-gray-dark);
    background: transparent;
    border: 2px solid var(--color-gray-light);
    cursor: pointer;
    transition: all 0.3s var(--ease-out);
    position: relative;
  }

  .blog-filter-tab:hover {
    color: var(--color-navy);
    border-color: var(--color-navy);
    transform: translateY(-2px);
  }

  .blog-filter-tab.is-active {
    background: var(--color-orange);
    color: white;
    border-color: var(--color-orange);
  }

  .blog-filter-tab.is-active:hover {
    transform: translateY(-2px);
  }

  .blog-filter-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 26px;
    height: 26px;
    padding: 0 7px;
    font-size: 11px;
    font-weight: 700;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    background: var(--color-gray-light);
    color: var(--color-gray-dark);
  }

  .blog-filter-tab.is-active .blog-filter-count {
    background: rgba(0, 0, 0, 0.2);
    color: white;
  }

  /* =============================================
     FEATURED POSTS SECTION
     ============================================= */
  .featured-section {
    padding: 80px 40px 40px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .featured-header {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-bottom: 40px;
  }

  .featured-label {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: var(--color-orange);
    white-space: nowrap;
  }

  .featured-line {
    flex: 1;
    height: 2px;
    background: var(--color-gray-light);
  }

  /* 1+3 Grid */
  .featured-grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    grid-template-rows: repeat(3, 1fr);
    gap: 20px;
  }

  /* Hero card: spans all 3 rows on left */
  .featured-card--hero {
    grid-row: 1 / 4;
    grid-column: 1;
  }

  .featured-card--small {
    grid-column: 2;
  }

  /* Card base */
  .featured-card {
    position: relative;
    overflow: hidden;
    border: 2px solid var(--color-navy);
    transition: all 0.4s var(--ease-out);
    background: white;
  }

  .featured-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(5, 10, 20, 0.15);
    border-color: var(--color-orange);
  }

  .featured-card a {
    display: block;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  /* Hero card image fills entire card */
  .featured-card--hero .featured-card-image {
    position: absolute;
    inset: 0;
  }

  .featured-card--hero a {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 500px;
  }

  .featured-card--hero .featured-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 10, 39, 0.92) 0%,
      rgba(0, 10, 39, 0.5) 45%,
      transparent 100%
    );
    z-index: 1;
  }

  .featured-card--hero .featured-card-content {
    position: relative;
    z-index: 2;
    padding: 40px;
    color: white;
  }

  .featured-card--hero .featured-card-title {
    font-size: 28px;
    color: white;
    margin-bottom: 12px;
  }

  .featured-card--hero .featured-card-category {
    background: var(--color-orange);
    color: white;
    padding: 4px 10px;
  }

  .featured-card--hero .featured-card-meta {
    color: rgba(255, 255, 255, 0.6);
  }

  /* Small cards: horizontal layout */
  .featured-card--small a {
    display: flex;
    flex-direction: row;
  }

  .featured-card--small .featured-card-image {
    width: 40%;
    min-width: 40%;
    position: relative;
  }

  .featured-card--small .featured-card-overlay {
    display: none;
  }

  .featured-card--small .featured-card-content {
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex: 1;
    min-width: 0;
  }

  .featured-card--small .featured-card-title {
    font-size: 16px;
    margin-bottom: 8px;
  }

  /* Shared card image styles */
  .featured-card-image {
    overflow: hidden;
    background: var(--color-navy);
  }

  .featured-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(30%);
    transition: all 0.5s var(--ease-out);
  }

  .featured-card:hover .featured-card-image img {
    filter: grayscale(0%);
    transform: scale(1.05);
  }

  .featured-card-badge {
    position: absolute;
    top: 16px;
    right: 16px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: var(--color-orange);
    color: var(--color-navy-deep);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    z-index: 3;
  }

  .featured-card-category {
    display: inline-block;
    padding: 3px 8px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-orange);
    margin-bottom: 8px;
  }

  .featured-card-title {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.5px;
    color: var(--color-navy);
  }

  .featured-card-excerpt {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.6;
    margin-bottom: 12px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .featured-card-meta {
    display: flex;
    gap: 12px;
    font-size: 13px;
    color: var(--color-gray);
  }

  /* =============================================
     SECTION DIVIDERS
     ============================================= */
  .section-divider {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-bottom: 40px;
  }

  .section-divider-label {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: var(--color-orange);
    white-space: nowrap;
  }

  .section-divider-line {
    flex: 1;
    height: 2px;
    background: var(--color-gray-light);
  }

  /* =============================================
     REGULAR POST GRID
     ============================================= */
  .blog-listing {
    padding: 60px 40px 80px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .blog-listing-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }

  .blog-listing-card {
    background: white;
    overflow: hidden;
    transition: all 0.4s var(--ease-out);
    border: 1px solid var(--color-gray-light);
  }

  .blog-listing-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(5, 10, 20, 0.15);
  }

  .blog-listing-card a {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .blog-listing-card-image {
    position: relative;
    aspect-ratio: 16/10;
    overflow: hidden;
    background: var(--color-navy);
  }

  .blog-listing-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(30%);
    transition: all 0.5s var(--ease-out);
  }

  .blog-listing-card:hover .blog-listing-card-image img {
    filter: grayscale(0%);
    transform: scale(1.05);
  }

  .blog-listing-card-category {
    position: absolute;
    top: 16px;
    left: 16px;
    padding: 6px 12px;
    background: var(--color-orange);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: white;
  }

  .blog-listing-card-content {
    padding: 28px;
  }

  .blog-listing-card-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.5px;
    margin-bottom: 12px;
    color: var(--color-navy);
  }

  .blog-listing-card-excerpt {
    font-size: 16px;
    color: var(--color-gray-dark);
    line-height: 1.6;
    margin-bottom: 16px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-listing-card-meta {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 13px;
    color: var(--color-gray);
  }

  .blog-listing-card-author {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: var(--color-navy);
  }

  .blog-listing-card-author-img {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-orange);
  }

  .blog-empty {
    text-align: center;
    padding: 80px 40px;
    color: var(--color-gray);
    font-size: 18px;
  }

  /* =============================================
     INFINITE SCROLL & FILTERING
     ============================================= */
  .blog-listing-card--hidden {
    display: none;
  }

  .blog-listing-card--filter-hidden {
    display: none !important;
  }

  .blog-listing-card--revealing {
    animation: cardReveal 0.4s ease-out forwards;
  }

  @keyframes cardReveal {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }

  #load-more-sentinel {
    height: 1px;
    margin-top: -1px;
  }

  /* =============================================
     NEWSLETTER (enhanced)
     ============================================= */
  .newsletter {
    position: relative;
    overflow: hidden;
  }

  .newsletter-bg-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-display);
    font-size: clamp(80px, 15vw, 220px);
    font-weight: 900;
    color: rgba(0, 0, 0, 0.06);
    pointer-events: none;
    user-select: none;
    white-space: nowrap;
  }

  .newsletter-content {
    position: relative;
    z-index: 1;
  }

  /* =============================================
     RESPONSIVE
     ============================================= */
  @media (max-width: 1024px) {
    /* Featured: switch to 2x2 grid */
    .featured-grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto;
    }

    .featured-card--hero {
      grid-row: auto;
      grid-column: auto;
    }

    .featured-card--hero a {
      min-height: 320px;
    }

    .featured-card--small a {
      flex-direction: column;
    }

    .featured-card--small .featured-card-image {
      width: 100%;
      aspect-ratio: 16/10;
    }
  }

  @media (max-width: 768px) {
    .blog-hero {
      padding: 100px 20px 60px;
    }

    .blog-hero-overlay {
      background: linear-gradient(
        135deg,
        rgba(0, 10, 39, 0.92) 0%,
        rgba(0, 10, 39, 0.8) 50%,
        rgba(0, 10, 39, 0.65) 100%
      );
    }

    /* Filters */
    .blog-filters {
      padding: 24px 20px;
    }

    .blog-filter-tab {
      padding: 10px 18px;
      font-size: 12px;
      letter-spacing: 1px;
    }

    .blog-filter-count {
      min-width: 22px;
      height: 22px;
      font-size: 10px;
