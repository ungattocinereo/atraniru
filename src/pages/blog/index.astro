</style>

<!-- Fallback: show all cards when JS is disabled -->
<noscript>
  <style>
    .blog-listing-card--hidden { display: block !important; }
  </style>
</noscript>

<script>
  // === Category Filtering + Infinite Scroll ===
  const filterTabs = document.querySelectorAll('.blog-filter-tab');
  const allCards = Array.from(document.querySelectorAll('.blog-listing-card'));
  const featuredCards = Array.from(document.querySelectorAll('.featured-card'));
  const grid = document.querySelector('.blog-listing-grid');
  const sentinel = document.getElementById('load-more-sentinel');
  const BATCH = parseInt(grid?.dataset.batchSize || '12', 10);

  let currentFilter = 'all';
  let visible = 0;

  // --- Filtering ---
  function getFilteredCards() {
    if (currentFilter === 'all') return allCards;
    return allCards.filter(c => c.dataset.tag === currentFilter);
  }

  function applyFilter(filter) {
    currentFilter = filter;

    // Update active tab
    filterTabs.forEach(tab => {
      tab.classList.toggle('is-active', tab.dataset.filter === filter);
    });

    // Filter featured cards
    featuredCards.forEach(card => {
      const show = filter === 'all' || card.dataset.tag === filter;
      card.style.display = show ? '' : 'none';
    });

    // Reset all regular cards
    allCards.forEach(card => {
      card.classList.remove('blog-listing-card--hidden', 'blog-listing-card--revealing', 'blog-listing-card--filter-hidden');
      card.style.animationDelay = '';
    });

    // Apply filter + batch visibility
    const filtered = getFilteredCards();
    let idx = 0;
    allCards.forEach(card => {
      const matchesFilter = filter === 'all' || card.dataset.tag === filter;
      if (!matchesFilter) {
        card.classList.add('blog-listing-card--filter-hidden');
        return;
      }
      if (idx >= BATCH) {
        card.classList.add('blog-listing-card--hidden');
      } else {
        // Staggered reveal animation
        card.classList.add('blog-listing-card--revealing');
        card.style.animationDelay = `${idx * 0.04}s`;
      }
      idx++;
    });

    visible = Math.min(BATCH, filtered.length);

    // Handle empty state
    handleEmptyState(filtered.length);

    // Reset infinite scroll
    resetInfiniteScroll(filtered.length);
  }

  filterTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const filter = tab.dataset.filter;
      if (filter !== currentFilter) applyFilter(filter);
    });
  });

  // --- Empty State ---
  function handleEmptyState(matchCount) {
    let emptyEl = document.querySelector('.blog-empty-filtered');
    if (matchCount === 0) {
      if (!emptyEl) {
        emptyEl = document.createElement('div');
        emptyEl.className = 'blog-empty blog-empty-filtered';
        emptyEl.innerHTML = '<p>В этой категории пока нет статей</p>';
        grid?.parentNode?.insertBefore(emptyEl, grid.nextSibling);
      }
      emptyEl.style.display = 'block';
    } else if (emptyEl) {
      emptyEl.style.display = 'none';
    }
  }

  // --- Infinite Scroll ---
  function revealNextBatch() {
    const filtered = getFilteredCards();
    const end = Math.min(visible + BATCH, filtered.length);
    for (let i = visible; i < end; i++) {
      const card = filtered[i];
      card.classList.remove('blog-listing-card--hidden');
      card.classList.add('blog-listing-card--revealing');
      card.style.animationDelay = `${(i - visible) * 0.04}s`;
    }
    visible = end;

    if (visible >= filtered.length && sentinel) {
      observer.unobserve(sentinel);
    }
  }

  function resetInfiniteScroll(totalFiltered) {
    if (!sentinel) return;
    if (totalFiltered > BATCH) {
      observer.observe(sentinel);
    } else {
      observer.unobserve(sentinel);
    }
  }

  const observer = new IntersectionObserver((entries) => {
    if (entries[0]?.isIntersecting) {
      revealNextBatch();
    }
  }, { rootMargin: '200px' });

  // Initial setup
  visible = Math.min(BATCH, allCards.length);
  if (grid && sentinel && allCards.length > BATCH) {
    observer.observe(sentinel);
  }
</script>
