<script>
  // Category filtering applies to the current crawlable archive page.
  const filterTabs = document.querySelectorAll('.blog-filter-tab');
  const cards = document.querySelectorAll<HTMLElement>('.blog-listing-card, .featured-card');

  function applyFilter(filter: string) {
    filterTabs.forEach(tab => {
      const element = tab as HTMLElement;
      element.classList.toggle('is-active', element.dataset.filter === filter);
    });
    cards.forEach(card => {
      card.hidden = filter !== 'all' && card.dataset.tag !== filter;
    });
  }

  filterTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      applyFilter((tab as HTMLElement).dataset.filter || 'all');
    });
  });
</script>
