---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import GhostImage from '../../../components/GhostImage.astro';
import { getAllPosts, formatDate } from '../../../lib/ghostApi';
import { rewriteGhostUrl } from '../../../lib/ghost';
import type { GhostPost } from '../../../lib/types/ghost';

const POSTS_PER_PAGE = 12;

export async function getStaticPaths() {
  const pageSize = 12;
  const allPosts = await getAllPosts({ limit: 'all' });
  const totalPages = Math.ceil(allPosts.length / pageSize);

  return Array.from({ length: Math.max(totalPages - 1, 0) }, (_, index) => {
    const page = index + 2;
    const start = (page - 1) * pageSize;
    return {
      params: { page: String(page) },
      props: {
        posts: allPosts.slice(start, start + pageSize),
        totalPages,
      },
    };
  });
}

interface Props {
  posts: GhostPost[];
  totalPages: number;
}

const { posts, totalPages } = Astro.props;
const currentPage = Number(Astro.params.page);
const previousUrl = currentPage === 2 ? '/blog' : `/blog/page/${currentPage - 1}`;
const nextUrl = currentPage < totalPages ? `/blog/page/${currentPage + 1}` : null;
const pageTitle = `Блог об Амальфи — страница ${currentPage} | Atrani.ru`;
const pageDescription = `Архив статей Atrani.ru об Амальфитанском побережье: маршруты, новости и практические советы от местных жителей. Страница ${currentPage}.`;
const archiveModified = posts
  .map((post) => post.updated_at || post.published_at)
  .filter(Boolean)
  .sort()
  .at(-1);
---

<Layout title={pageTitle} description={pageDescription} ogImage="/images/index/atrani-4-index.webp">
  <link slot="head" rel="prev" href={`https://atrani.ru${previousUrl}`} />
  {nextUrl && <link slot="head" rel="next" href={`https://atrani.ru${nextUrl}`} />}
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: pageTitle,
    url: `https://atrani.ru/blog/page/${currentPage}`,
    dateModified: archiveModified,
    isPartOf: { '@type': 'Blog', '@id': 'https://atrani.ru/blog' },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: posts.map((post, index) => ({
        '@type': 'ListItem',
        position: (currentPage - 1) * POSTS_PER_PAGE + index + 1,
        url: `https://atrani.ru/blog/${post.slug}`,
        name: post.title,
      })),
    },
  })} />

  <Breadcrumbs items={[
    { name: 'Главная', url: '/' },
    { name: 'Блог', url: '/blog' },
    { name: `Страница ${currentPage}`, url: `/blog/page/${currentPage}` },
  ]} hideVisually={true} />

  <header class="archive-hero">
    <p>Блог Atrani.ru</p>
    <h1>Статьи об Амальфи — страница {currentPage}</h1>
    <a href="/blog">← К свежим публикациям</a>
  </header>

  <section class="archive-grid" aria-label="Статьи">
    {posts.map((post) => (
      <article class="archive-card">
        <a href={`/blog/${post.slug}`}>
          <div class="archive-image">
            <GhostImage
              src={rewriteGhostUrl(post.feature_image) || '/images/placeholder-blog.jpg'}
              alt={post.feature_image_alt || post.title}
              loading="lazy"
              sizes="(max-width: 768px) 100vw, 33vw"
              widths={[600, 960, 1200, 1600]}
            />
          </div>
          <div class="archive-content">
            {post.primary_tag && <span>{post.primary_tag.name}</span>}
            <h2>{post.title}</h2>
            <p>{post.custom_excerpt || post.excerpt}</p>
            <time datetime={post.published_at}>{formatDate(post.published_at)}</time>
          </div>
        </a>
      </article>
    ))}
  </section>

  <nav class="archive-pagination" aria-label="Страницы блога">
    <a href={previousUrl} rel="prev">← Предыдущая</a>
    {Array.from({ length: totalPages }, (_, index) => index + 1).map((page) => (
      page === currentPage
        ? <span aria-current="page">{page}</span>
        : <a href={page === 1 ? '/blog' : `/blog/page/${page}`}>{page}</a>
    ))}
    {nextUrl && <a href={nextUrl} rel="next">Следующая →</a>}
  </nav>
</Layout>

<style>
  .archive-hero {
    padding: 180px 40px 72px;
    background: var(--color-navy-deep);
    color: white;
  }

  .archive-hero > * {
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
  }

  .archive-hero > p {
    color: var(--color-orange);
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .archive-hero h1 {
    margin-top: 16px;
    font-family: var(--font-display);
    font-size: clamp(36px, 6vw, 78px);
    line-height: 1;
  }

  .archive-hero a {
    display: block;
    margin-top: 28px;
    color: white;
  }

  .archive-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    width: min(1200px, calc(100% - 48px));
    margin: 0 auto;
    padding: 80px 0 40px;
  }

  .archive-card {
    border: 2px solid var(--color-navy);
  }

  .archive-card > a {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .archive-image {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-navy);
  }

  .archive-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .archive-content {
    padding: 24px;
  }

  .archive-content > span {
    color: var(--color-orange);
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .archive-content h2 {
    margin: 12px 0;
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1.25;
  }

  .archive-content p {
    line-height: 1.6;
  }

  .archive-content time {
    display: block;
    margin-top: 18px;
    color: var(--color-gray-dark);
    font-size: 13px;
  }

  .archive-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    padding: 32px 24px 96px;
  }

  .archive-pagination a,
  .archive-pagination span {
    display: inline-flex;
    min-height: 44px;
    min-width: 44px;
    align-items: center;
    justify-content: center;
    padding: 10px 14px;
    border: 2px solid var(--color-navy);
    color: var(--color-navy);
    font-weight: 800;
    text-decoration: none;
  }

  .archive-pagination span {
    background: var(--color-orange);
    border-color: var(--color-orange);
    color: white;
  }

  @media (max-width: 900px) {
    .archive-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 620px) {
    .archive-hero { padding: 140px 20px 56px; }
    .archive-grid { grid-template-columns: 1fr; }
  }
</style>
