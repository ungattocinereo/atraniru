            font-weight: 800;
            color: var(--color-navy-deep);
            line-height: 1.2;
        }
        .warning-card:hover .warning-title {
            color: white;
        }
        .warning-text {
            font-size: 14px;
            line-height: 1.6;
            color: var(--color-gray-dark);
            margin: 0;
        }
        .warning-card:hover .warning-text {
            color: var(--color-gray-light);
        }

        /* Alternatives Section */
        .alternatives {
            padding: 120px 40px;
            background: var(--color-bg-light);
        }
        .alt-cards {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 32px;
            max-width: 1200px;
            margin: 0 auto;
        }
        .alt-card {
            background: white;
            border: 2px solid var(--color-navy);
            overflow: hidden;
            transition: all 0.3s var(--ease-out);
            display: flex;
            flex-direction: column;
        }
        .alt-card:hover {
            transform: translate(-4px, -4px);
            box-shadow: 4px 4px 0 var(--color-navy);
        }
        .alt-image {
            aspect-ratio: 16/10;
            overflow: hidden;
        }
        .alt-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s var(--ease-out);
        }
        .alt-card:hover .alt-image img {
            transform: scale(1.05);
        }
        .alt-content {
            padding: 32px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }
        .alt-name {
            font-family: var(--font-display);
            font-size: 28px;
            font-weight: 800;
            color: var(--color-navy-deep);
            letter-spacing: -0.5px;
        }
        .alt-desc {
            font-size: 15px;
            line-height: 1.7;
            color: var(--color-gray-dark);
            margin: 0;
        }

        /* Tools Section */
        .tools-section {
            padding: 120px 40px;
            background: white;
        }
        .tools-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            max-width: 1200px;
            margin: 0 auto;
        }
        .tools-subtitle {
            font-family: var(--font-display);
            font-size: 14px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 3px;
            color: var(--color-orange);
            margin-bottom: 24px;
        }
        .tools-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .tool-link {
            display: grid;
            grid-template-columns: auto 1fr auto;
            grid-template-areas: 'name arrow' 'desc desc';
            gap: 8px 16px;
            padding: 20px 24px;
            background: var(--color-bg-light);
            color: var(--color-navy-deep);
            text-decoration: none;
            transition: all 0.3s var(--ease-out);
            border-left: 3px solid transparent;
        }
        .tool-link:hover {
            background: var(--color-navy-deep);
            color: white;
            border-left-color: var(--color-orange);
        }
        .tool-name {
            grid-area: name;
            font-weight: 700;
            font-size: 17px;
        }
        .tool-arrow {
            grid-area: arrow;
            color: var(--color-orange);
        }
        .tool-link:hover .tool-arrow {
            color: var(--color-orange);
        }
        .tool-desc {
            grid-area: desc;
            font-size: 14px;
            color: var(--color-gray-dark);
        }
        .tool-link:hover .tool-desc {
            color: var(--color-gray-light);
        }

        .contacts-card {
            background: var(--color-navy-deep);
            color: white;
            padding: 32px;
        }
        .contacts-card .tools-subtitle {
            color: var(--color-orange);
        }
        .contact-item {
            display: flex;
            flex-direction: column;
            gap: 4px;
            padding: 16px 0;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            text-decoration: none;
            color: white;
            transition: all 0.3s var(--ease-out);
        }
        .contact-item:last-child {
            border-bottom: none;
        }
        .contact-item:hover {
            padding-left: 8px;
            color: var(--color-orange);
        }
        .contact-name {
            font-size: 14px;
            color: var(--color-gray);
        }
        .contact-phone {
            font-family: var(--font-display);
            font-size: 18px;
            font-weight: 700;
            color: white;
        }
        .contact-item:hover .contact-phone {
            color: var(--color-orange);
        }

        /* CTA Section */
        .cta {
            background: var(--color-orange);
            padding: 120px 40px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        .cta::before {
            content: 'AMALFI';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-family: var(--font-display);
            font-size: clamp(150px, 25vw, 400px);
            font-weight: 900;
            color: rgba(0, 0, 0, 0.05);
            pointer-events: none;
            white-space: nowrap;
        }
        .cta-content {
            position: relative;
            z-index: 1;
            max-width: 800px;
            margin: 0 auto;
        }
        .cta .section-title {
            color: white;
            margin-bottom: 24px;
        }
        .cta p {
            font-size: 20px;
            line-height: 1.6;
            color: rgba(255, 255, 255, 0.9);
            margin-bottom: 40px;
        }
        .cta-actions {
            display: flex;
            gap: 16px;
            justify-content: center;
            flex-wrap: wrap;
        }

        /* Responsive */
        @media (max-width: 1024px) {
            .intro-grid,
            .tools-grid {
                grid-template-columns: 1fr;
                gap: 60px;
            }
            .alt-cards {
                grid-template-columns: 1fr;
            }
            .towns-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .intro-section,
            .towns,
            .ztl,
            .strategies-section,
            .routes-section,
            .warnings-section,
            .alternatives,
            .tools-section,
            .cta {
                padding: 80px 20px;
            }
            .town-header {
                flex-direction: column;
                align-items: flex-start;
            }
            .ztl-alert {
                padding: 24px 20px;
            }
            .alert-head {
                flex-wrap: wrap;
            }
            .warnings-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>

    <script>
        // Scroll reveal animations
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                }
            });
        }, {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        });

        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    </script>
</Layout>
