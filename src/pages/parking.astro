---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
        {
            "@type": "Question",
            "name": "Сколько стоит парковка на Амальфитанском побережье в 2026 году?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "В среднем €3–5 в час в платных зонах, в Позитано — €8–12 в час. Самые дорогие частные гаражи доходят до €50–90 в сутки. Дешевле всего в Виетри-суль-Маре (€1,50–2 в час). Цены в высокий сезон (апрель–октябрь) выше."
            }
        },
        {
            "@type": "Question",
            "name": "Что такое ZTL и какой штраф за въезд?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "ZTL (Zona a Traffico Limitato) — зоны ограниченного движения в исторических центрах Амальфи, Позитано, Равелло и Атрани. Контролируются камерами по номерам. Штраф — от €150 плюс эвакуация при необходимости. Гости отелей могут быть освобождены, если отель зарегистрирует номер машины."
            }
        },
        {
            "@type": "Question",
            "name": "Можно ли парковаться в Атрани?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "С июня по сентябрь только 4 часа подряд по €3/час с 8:00 до 20:00. Ночная парковка с 20:00 до 8:00 запрещена. Атрани не подходит как база для дневной стоянки летом — лучше использовать гараж Luna Rossa в Амальфи (туннель напрямую соединяет города)."
            }
        },
        {
            "@type": "Question",
            "name": "Где парковаться в Позитано в высокий сезон?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Лучшая стратегия — приехать до 9:00 утра или оставить машину в Ночелле/Монтепертузо (бесплатно) и спуститься на автобусе Flavio Gioia за €1,60. Платные синие зоны — €3/час, частные гаражи в центре — €8–12/час. После 10:00 летом свободных мест почти нет."
            }
        },
        {
            "@type": "Question",
            "name": "Какие приложения для оплаты парковки работают в Италии?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "EasyPark — самое популярное приложение по всей Италии. Работает в большинстве городов побережья: можно платить и продлевать парковку удалённо в синих зонах. Не нужно бегать к паркомату с монетами."
            }
        },
        {
            "@type": "Question",
            "name": "Как сэкономить на парковке на Амальфи?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Три рабочих стратегии: 1) Park & Ride — оставить машину в Салерно или Виетри-суль-Маре и ездить паромами TravelMar или автобусами SITA. Экономия €30–50/сутки. 2) Бронировать отель с парковкой (часто бесплатно). 3) Использовать дневной абонемент в Прайано: €15 за 6 часов или €30 за 14 часов."
            }
        }
    ]
};

const towns = [
    {
        name: 'Амальфи',
        badge: 'Лучший для ночёвки',
        options: [
            {
                name: 'Гараж Luna Rossa',
                perHour: '2–4€',
                perDay: '25–45€',
                notes: '170 авто + 30 мото. Долгая стоянка: 40€/сутки в высокий сезон (Пасха – 3 ноября, 27 дек. – 6 янв.); 25€/сутки в межсезонье. Туннель напрямую соединяет с Атрани.',
                limits: 'Запрет газовых машин (метан). Макс. высота 2 м. Заезд/выезд в 12:00.',
                source: 'official'
            },
            {
                name: 'Il Porto (Piazza Flavio Gioia)',
                perHour: '3–6€',
                notes: 'У самого порта. На первые 2 часа возможна надбавка.',
                limits: 'Цены меняются по сезону — внимательно читайте знаки.',
                source: 'aggregate'
            }
        ],
        tip: 'Luna Rossa — самый предсказуемый вариант на 1+ ночь. Официальный тариф lunga sosta убирает почасовую путаницу.'
    },
    {
        name: 'Позитано',
        badge: 'Самый сложный',
        options: [
            {
                name: 'Синие зоны (strisce blu)',
                perHour: '3€',
                perDay: '8€',
                notes: 'Самый дешёвый вариант, если повезёт найти место. По данным туристического бюро Позитано.',
                limits: 'Мест очень мало, оборачиваются быстро в высокий сезон.',
                source: 'official'
            },
            {
                name: 'Частные гаражи в центре',
                perHour: '8–12€',
                perDay: '50–90€',
                notes: 'Самые дорогие на побережье. Часто заняты к 10:00 летом.',
                limits: 'Каждый начатый час — полный. Внимательно читайте прайс.',
                source: 'private'
            },
            {
                name: 'Ночелле / Монтепертузо',
                perHour: 'бесплатно',
                perDay: 'бесплатно',
                notes: 'Парковка в горах над Позитано. Вниз — на автобусе Flavio Gioia (€1,60) или пешком ~35 минут по лестницам.',
                limits: 'Даже здесь мест мало в пик.',
                source: 'local'
            }
        ],
        tip: 'Приезжайте до 9:00 или паркуйтесь в горах и спускайтесь автобусом. Договаривайтесь с отелем заранее.'
    },
    {
        name: 'Равелло',
        badge: 'Горный город',
        options: [
            {
                name: 'Parcheggio Auditorium (Оскар Нимейер)',
                perHour: '4€',
                perDay: '40€',
                notes: 'Официально: 4€/час с 08:00 до 24:00, 2,50€/час ночью. 80 мест.',
                limits: 'Разные секции — разные правила (lato monte/valle). Читайте знаки.',
                source: 'official'
            },
            {
                name: 'Зона Piazza Duomo',
                perHour: '2,50–5€',
                perDay: '15–30€',
                notes: '~140 мест. Цены меняются по сезону.',
                limits: 'Может закрываться на фестивали, свадьбы, праздники.',
                source: 'aggregate'
            }
        ],
        tip: 'Базовый бюджет: 4€/час или 40€/сутки. Но всегда сверяйтесь с разметкой на месте.'
    },
    {
        name: 'Атрани',
        badge: 'Жёсткие лимиты',
        options: [
            {
                name: 'Синие зоны',
                perHour: '3€',
                notes: 'Официально: с июня по сентябрь для нерезидентов 3€/час, максимум 4 часа подряд (08:00–20:00).',
                limits: 'Ночная парковка летом запрещена с 20:00 до 08:00. Не подходит как база на день.',
                source: 'official'
            }
        ],
        tip: 'НЕ планируйте Атрани как место дневной стоянки летом. Лимит 4 часа и запрет на ночь делают его непрактичным.'
    },
    {
        name: 'Прайано',
        badge: 'Прозрачный прайс',
        options: [
            {
                name: 'Синие зоны (strisce blu)',
                perHour: '3€',
                perDay: '30€',
                notes: 'Официально: 3€/час круглый год. Дневные пакеты: 15€ за 6 часов, 30€ за 14 часов. Месячный абонемент для нерезидентов: 100€.',
                limits: 'Апр.–окт.: 08:00–22:00. Нояб.–март: 08:00–20:00. Праздники тоже платные.',
                source: 'official'
            }
        ],
        tip: 'Если стоите 6+ часов, дневной пакет за €15 выгоднее почасового. Месячный абонемент идеален для регулярных поездок.'
    },
    {
        name: 'Майори',
        badge: 'Удобнее всего',
        options: [
            {
                name: 'Синие зоны на набережной',
                perHour: '3€',
                notes: 'Мест больше, чем в Позитано или Амальфи.',
                limits: 'Сезонные цены.',
                source: 'aggregate'
            },
            {
                name: 'Costa d\'Angolo Pietra di Luna',
                perHour: '3–5€',
                perDay: '20–30€',
                notes: '100+ мест, шлагбаум, видеонаблюдение. Будни 3€/час (20–25€/сутки). Выходные 5€/час (25–30€/сутки).',
                limits: 'Охраняемая парковка с прозрачным прайсом.',
                source: 'private'
            }
        ],
        tip: 'Один из самых лёгких городов для парковки. Хорошая база для вылазок в Минори и Амальфи.'
    },
    {
        name: 'Минори',
        badge: 'Маленький город',
        options: [
            {
                name: 'Via Pioppi / набережная',
                perHour: '3€',
                notes: 'Мест немного, но доступнее, чем у соседей.',
                limits: 'Общая ёмкость небольшая.',
                source: 'aggregate'
            }
        ],
        tip: 'Тихая альтернатива Амальфи с приличным автобусным сообщением.'
    },
    {
        name: 'Четара',
        badge: 'Рыбацкий городок',
        options: [
            {
                name: 'Синие зоны у порта',
                perHour: '1,50–4€',
                notes: 'Места исчезают быстро в часы рестораном и активности порта.',
                limits: 'Очень ограниченная ёмкость.',
                source: 'aggregate'
            }
        ],
        tip: 'Отлично для ужина, но после полудня летом на место не рассчитывайте.'
    },
    {
        name: 'Виетри-суль-Маре',
        badge: 'Самое дешёвое',
        options: [
            {
                name: 'Piazza Matteotti / Marina',
                perHour: '1,50–2€',
                notes: 'Самые низкие цены на побережье. Две большие муниципальные стоянки у пляжа.',
                limits: 'Близко к Салерно, отличное автобусное и паромное сообщение.',
                source: 'aggregate'
            }
        ],
        tip: 'Лучшая бюджетная стратегия: оставить машину тут и ездить паромами или автобусами по побережью. Экономия €30–50/сутки против Позитано.'
    },
    {
        name: 'Конка-деи-Марини',
        badge: 'Очень мало мест',
        options: [
            {
                name: 'Муниципальные синие зоны',
                perDay: '20€',
                notes: 'Мест действительно очень мало. Узкие дороги.',
                limits: '«Парковка как повезёт» — мест реально не хватает.',
                source: 'official'
            }
        ],
        tip: 'Не рассчитывайте найти тут место. Планируйте альтернативу.'
    },
    {
        name: 'Фуроре',
        badge: 'Удалённый',
        options: [
            {
                name: 'La Praia',
                perHour: '2,50€',
                notes: '2 км пешком до фьорда.',
                limits: 'Мест ограниченное число.',
                source: 'aggregate'
            }
        ],
        tip: 'Готовьтесь идти пешком. Фьорд того стоит.'
    }
];

const sourceLabels = {
    official: 'Официально',
    aggregate: 'По данным',
    private: 'Частный',
    local: 'Местная инфо'
};

const strategies = [
    {
        accent: 'Стратегия',
        title: 'Park & Ride',
        text: 'Оставьте машину в большой и дешёвой парковке (Салерно, Виетри-суль-Маре или Сорренто) и перемещайтесь по побережью паромами или автобусами SITA. В пик сезон проблема не в цене — в наличии мест.'
    },
    {
        accent: 'До 9:00 утра',
        title: 'Приезжайте рано',
        text: 'После 10:00 летом даже платные гаражи в Позитано и Амальфи заняты. Ранний приезд — самая эффективная одиночная стратегия, чтобы найти место.'
    },
    {
        accent: 'Удалённо',
        title: 'Приложение EasyPark',
        text: 'Оплачивайте и продлевайте парковку в синих зонах удалённо по всей Италии. Не нужно бегать к паркомату. Работает в большинстве городов побережья.'
    },
    {
        accent: 'Включена',
        title: 'Отель с парковкой',
        text: 'Многие отели и B&B предлагают парковку (бесплатно или €15–25/сутки). Это сэкономит €25–50/сутки против общественных гаражей в популярных городах.'
    }
];

const routes = [
    {
        title: 'Бюджет + комфорт',
        recommended: true,
        base: 'Майори или Минори',
        benefits: [
            'Доступная парковка (3€/час)',
            'Хорошее автобусное и паромное сообщение',
            'Менее людные пляжи',
            'Много ресторанов'
        ]
    },
    {
        title: 'Без машины',
        base: 'Салерно или Виетри-суль-Маре',
        benefits: [
            'Самая дешёвая парковка (1,50–2€/час)',
            'Перемещения паромами TravelMar',
            'Экономия €30–50/сутки на парковке',
            'Без стресса серпантина'
        ]
    },
    {
        title: 'Полная мобильность',
        base: 'Отель с парковкой в Равелло',
        benefits: [
            'Парковка часто включена',
            'Тихая горная база',
            'Захватывающие виды',
            'Лёгкий выезд в любой город'
        ]
    }
];

const warnings = [
    {
        title: 'Не паркуйтесь на обочине SS163',
        text: 'Никогда не ставьте машину на обочине SS163 (прибрежного шоссе). Массовая эвакуация — обычное дело. Штраф + эвакуатор = €150–250+.'
    },
    {
        title: 'Цвет линий разметки',
        text: 'Белые линии = только резиденты. Жёлтые = только спецслужбы. Парковка там — гарантированный штраф. Ищите знаки «Solo Residenti».'
    },
    {
        title: 'Заправок почти нет',
        text: 'На самом побережье заправок почти не найти. Заправляйтесь в Салерно или ДО въезда на прибрежную дорогу.'
    },
    {
        title: 'Наличные на парковку',
        text: 'Многие паркоматы и небольшие стоянки принимают только наличные. Держите при себе мелкие купюры и монеты.'
    }
];
---

<Layout
    title="Парковка на Амальфи 2026: цены, ZTL, гаражи | Atrani.ru"
    description="Полный гид по парковкам Амальфитанского побережья: цены 2026, зоны ZTL, гаражи в Позитано, Амальфи, Равелло. Стратегии экономии и предупреждения о штрафах."
    ogImage="/images/atrani-with-3-bikes-no-plates.webp"
    ogImageAlt="Парковка на Амальфитанском побережье"
>
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />
    <Breadcrumbs items={[{ name: 'Главная', url: '/' }, { name: 'Парковки', url: '/parking' }]} hideVisually={true} />

    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-bg-text" aria-hidden="true">PARKING</div>

        <div class="hero-content">
            <p class="hero-label">Амальфитанское побережье</p>
            <h1>
                <span class="highlight">ПАРКОВ-</span>
                КИ
            </h1>
            <p class="hero-subtitle">Где, по чём и как не получить штраф. Полный гайд 2026 — цены, ZTL и стратегии экономии.</p>
            <div class="hero-actions">
                <a href="#prices" class="btn btn-white">Цены по городам</a>
                <a href="#ztl" class="btn btn-outline" style="border-color: white; color: white;">Зоны ZTL</a>
            </div>
        </div>

        <div class="hero-image">
            <img src="/images/atrani-with-3-bikes-no-plates.webp" alt="Атрани, узкие улицы и припаркованные мотоциклы" decoding="async" loading="eager">
        </div>

        <div class="scroll-indicator">Scroll</div>
    </section>

    <!-- Marquee -->
    <div class="marquee" aria-hidden="true">
        <div class="marquee-content">
            <div class="marquee-item">
                POSITANO <span></span> AMALFI <span></span> RAVELLO <span></span> ATRANI <span></span> ZTL <span></span> EASYPARK <span></span>
            </div>
            <div class="marquee-item">
                POSITANO <span></span> AMALFI <span></span> RAVELLO <span></span> ATRANI <span></span> ZTL <span></span> EASYPARK <span></span>
            </div>
        </div>
    </div>

    <!-- Reality Check -->
    <section class="intro-section">
        <div class="intro-grid">
            <div class="intro-content reveal">
                <div class="section-header">
                    <p class="section-label">Честно о главном</p>
                    <h2 class="section-title">Парковка тут — это реально сложно</h2>
                </div>
                <p class="intro-text">
                    Амальфитанское побережье остаётся одним из самых неудобных мест Италии для парковки. Города построены вертикально по скалам, ровного места почти нет. В пик сезона (апрель–октябрь) средний тариф €5–8 в час, а после 10:00 утра найти место в Позитано или Амальфи практически невозможно.
                </p>
                <p class="intro-text">
                    Этот гайд собирает официальные муниципальные тарифы, проверенные цены частных гаражей и рабочие стратегии экономии. Мы обновляем его каждый сезон.
                </p>

                <div class="line-legend">
                    <div class="legend-item legend-blue">
                        <span class="legend-bar"></span>
                        <span><strong>Синие линии</strong> — платная парковка (strisce blu)</span>
                    </div>
                    <div class="legend-item legend-white">
                        <span class="legend-bar"></span>
                        <span><strong>Белые линии</strong> — бесплатно, но обычно только резиденты</span>
                    </div>
                    <div class="legend-item legend-yellow">
                        <span class="legend-bar"></span>
                        <span><strong>Жёлтые линии</strong> — спецслужбы. Штраф гарантирован.</span>
                    </div>
                </div>
            </div>
            <div class="intro-image reveal">
                <img src="/images/transport/bus-amalfi-atrani-salerno.webp" alt="Серпантин Амальфитанского побережья" decoding="async" loading="lazy">
            </div>
        </div>
    </section>

    <!-- Prices by Town -->
    <section class="towns" id="prices">
        <div class="section-header reveal">
            <p class="section-label">01 — Цены</p>
            <h2 class="section-title">В каждом городе разная цена</h2>
        </div>

        <p class="section-intro reveal">
            Цены ниже отражают официальные муниципальные тарифы 2025–2026 (где опубликованы) и проверенные диапазоны частных гаражей. В высокий сезон цены могут меняться.
        </p>

        <div class="towns-grid">
            {towns.map((town) => (
                <article class="town-card reveal">
                    <div class="town-header">
                        <h3 class="town-name">{town.name}</h3>
                        <span class="town-badge">{town.badge}</span>
                    </div>

                    <div class="town-options">
                        {town.options.map((opt) => (
                            <div class="parking-option">
                                <div class="option-head">
                                    <span class="option-name">{opt.name}</span>
                                    <span class={`option-source source-${opt.source}`}>{sourceLabels[opt.source]}</span>
                                </div>
                                <div class="option-prices">
                                    {opt.perHour && (
                                        <div class="price-block">
                                            <span class="price-label">в час</span>
                                            <span class="price-value">{opt.perHour}</span>
                                        </div>
                                    )}
                                    {opt.perDay && (
                                        <div class="price-block">
                                            <span class="price-label">в сутки</span>
                                            <span class="price-value">{opt.perDay}</span>
                                        </div>
                                    )}
                                </div>
                                {opt.notes && <p class="option-notes">{opt.notes}</p>}
                                {opt.limits && <p class="option-limits"><strong>Ограничения:</strong> {opt.limits}</p>}
                            </div>
                        ))}
                    </div>

                    <div class="town-tip">
                        <span class="tip-icon" aria-hidden="true">→</span>
                        <span>{town.tip}</span>
                    </div>
                </article>
            ))}
        </div>
    </section>

    <!-- ZTL Zones -->
    <section class="ztl" id="ztl">
        <div class="ztl-bg-text" aria-hidden="true">ZTL</div>
        <div class="ztl-content">
            <div class="section-header reveal">
