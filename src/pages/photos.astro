    font-size: 18px;
    line-height: 1.8;
    color: var(--color-gray-dark);
  }

  /* ===== SHOWCASE CAROUSEL (replaces "Каждый кадр") ===== */
  .showcase {
    position: relative;
    height: 80vh;
    min-height: 560px;
    max-height: 820px;
    overflow: hidden;
    background: var(--color-navy-deep);
  }

  .showcase-slideshow {
    position: absolute;
    inset: 0;
  }

  .showcase-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .showcase-slide.is-active {
    opacity: 1;
  }

  .showcase-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 10, 39, 0.15) 0%, rgba(0, 10, 39, 0.35) 55%, rgba(0, 10, 39, 0.92) 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 60px 40px;
    color: white;
    z-index: 1;
  }

  .showcase-content {
    max-width: 1400px;
    width: 100%;
    margin: 0 auto;
  }

  .showcase-label {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: var(--color-orange);
    margin-bottom: 16px;
  }

  .showcase-title {
    font-family: var(--font-display);
    font-size: clamp(48px, 9vw, 120px);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -3px;
    margin: 0 0 20px;
    color: white;
  }

  .showcase-sub {
    font-size: clamp(16px, 1.6vw, 20px);
    max-width: 640px;
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.5;
    margin: 0 0 32px;
  }

  .showcase-dots {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    gap: 12px;
  }

  .showcase-dot {
    width: 44px;
    height: 3px;
    background: rgba(255, 255, 255, 0.25);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background 0.4s, transform 0.4s;
  }

  .showcase-dot.is-active {
    background: var(--color-orange);
    transform: scaleY(1.6);
  }

  .showcase-dot:hover {
    background: rgba(255, 255, 255, 0.5);
  }

  /* ===== PS SECTIONS ===== */
  .ps-section {
    padding: 120px 40px;
    background: white;
  }

  .ps-section .section-header {
    max-width: 1200px;
    margin: 0 auto 80px;
  }

  .ps-included {
    background: var(--color-bg-light);
  }

  .ps-seasons {
    background: var(--color-bg-light);
  }

  .ps-testimonials {
    background: var(--color-navy-deep);
    color: white;
  }

  .ps-testimonials .section-label {
    color: var(--color-orange);
  }

  .ps-testimonials .section-title {
    color: white;
  }

  .ps-partners {
    background: var(--color-navy-deep);
    color: white;
    padding: 80px 40px;
  }

  .ps-partners .section-title {
    color: white;
  }

  /* ===== PACKAGES ===== */
  .ps-packages-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
    background: var(--color-navy);
  }

  @media (min-width: 769px) {
    .ps-packages-grid > .ps-package:nth-child(3) {
      order: 2;
    }
  }

  .ps-package {
    position: relative;
    padding: 48px 40px;
    background: white;
    display: flex;
    flex-direction: column;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ps-package:hover {
    transform: translateY(-6px);
  }

  .ps-package-featured {
    background: var(--color-navy-deep);
    color: white;
  }

  .ps-package-ribbon {
    position: absolute;
    top: 24px;
    right: 24px;
    padding: 8px 14px;
    background: var(--color-orange);
    color: white;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .ps-package-tag {
    align-self: flex-start;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: var(--color-orange);
    margin-bottom: 20px;
  }

  .ps-package-title {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.5px;
    margin-bottom: 24px;
  }

  .ps-package-price {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 28px;
    padding-bottom: 28px;
    border-bottom: 1px solid rgba(139, 155, 180, 0.3);
  }

  .ps-package-featured .ps-package-price {
    border-bottom-color: rgba(255, 255, 255, 0.15);
  }

  .ps-price-amount {
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 900;
    color: var(--color-orange);
    line-height: 1;
  }

  .ps-price-meta {
    font-size: 14px;
    color: var(--color-gray);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ps-package-list {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    flex: 1;
  }

  .ps-package-list li {
    padding: 8px 0 8px 20px;
    position: relative;
    font-size: 15px;
    line-height: 1.5;
  }

  .ps-package-list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--color-orange);
    font-weight: 700;
  }

  .ps-package-for {
    font-size: 13px;
    font-style: italic;
    color: var(--color-gray);
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid rgba(139, 155, 180, 0.2);
  }

  .ps-package-featured .ps-package-for {
    color: rgba(255, 255, 255, 0.6);
    border-top-color: rgba(255, 255, 255, 0.1);
  }

  .ps-package-cta {
    max-width: 1200px;
    margin: 60px auto 0;
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  /* ===== INCLUDED ===== */
  .ps-included-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    background: var(--color-navy);
  }

  .ps-included-item {
    padding: 40px 32px;
    background: var(--color-bg-light);
  }

  .ps-included-num {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    color: var(--color-orange);
    margin-bottom: 20px;
  }

  .ps-included-item h3 {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 12px;
    letter-spacing: -0.3px;
  }

  .ps-included-item p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-gray-dark);
  }

  /* ===== ZONES ===== */
  .ps-zones-table {
    max-width: 960px;
    margin: 0 auto;
    border: 2px solid var(--color-navy);
  }

  .ps-zone-row {
    display: grid;
    grid-template-columns: 140px 1fr 180px;
    gap: 24px;
    padding: 20px 28px;
    border-bottom: 1px solid var(--color-gray-light);
    align-items: center;
    font-size: 15px;
  }

  .ps-zone-row:last-child {
    border-bottom: none;
  }

  .ps-zone-head {
    background: var(--color-navy);
    color: white;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    border-bottom: none;
  }

  .ps-zone-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-orange);
  }

  .ps-zone-price {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 16px;
    text-align: right;
  }

  .ps-zones-note {
    max-width: 960px;
    margin: 32px auto 0;
    font-size: 14px;
    color: var(--color-gray-dark);
    font-style: italic;
    line-height: 1.6;
    text-align: center;
  }

  /* ===== ADD-ONS ===== */
  .ps-addons-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    background: var(--color-navy);
  }

  .ps-addon {
    padding: 32px 28px;
    background: white;
    border: 1px solid var(--color-gray-light);
    position: relative;
  }

  .ps-addon-price {
    display: block;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
    color: var(--color-orange);
    margin-bottom: 12px;
  }

  .ps-addon h3 {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 8px;
    letter-spacing: -0.3px;
  }

  .ps-addon p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-gray-dark);
    margin: 0;
  }

  .ps-addons-note {
    max-width: 1200px;
    margin: 32px auto 0;
    font-size: 13px;
    color: var(--color-gray-dark);
    text-align: center;
    font-style: italic;
  }

  /* ===== SEASONS ===== */
  .ps-seasons-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    background: var(--color-navy);
  }

  .ps-season {
    position: relative;
    padding: 40px 32px;
    background: white;
  }

  .ps-season-featured {
    background: var(--color-navy-deep);
    color: white;
  }

  .ps-season-badge {
    position: absolute;
    top: 20px;
    right: 20px;
    padding: 8px 14px;
    background: var(--color-orange);
    color: white;
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1px;
  }

  .ps-season-head {
    margin-bottom: 20px;
  }

  .ps-season h3 {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 6px;
    letter-spacing: -0.3px;
  }

  .ps-season-months {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-gray);
  }

  .ps-season-featured .ps-season-months {
    color: rgba(255, 255, 255, 0.6);
  }

  .ps-season-price {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    color: var(--color-orange);
    margin-bottom: 14px;
  }

  .ps-season-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-gray-dark);
    margin: 0;
  }

  .ps-season-featured .ps-season-desc {
    color: rgba(255, 255, 255, 0.75);
  }

  .ps-season-featured--orange {
    background: var(--color-orange);
    color: white;
  }

  .ps-season-featured--orange .ps-season-months {
    color: rgba(255, 255, 255, 0.85);
  }

  .ps-season-featured--orange .ps-season-price {
    color: white;
  }

  .ps-season-featured--orange .ps-season-desc {
    color: rgba(255, 255, 255, 0.92);
  }

  .ps-season-featured--orange .ps-season-badge {
    background: white;
    color: var(--color-orange);
  }

  .ps-seasons-loyalty {
    max-width: 800px;
    margin: 40px auto 0;
    font-size: 15px;
    text-align: center;
    color: var(--color-gray-dark);
    font-style: italic;
    line-height: 1.6;
  }

  /* ===== PORTFOLIO GALLERY ===== */
  .ps-portfolio {
    padding: 120px 40px;
  }

  .ps-gallery {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    background: var(--color-navy);
  }

  .ps-gallery-2col {
    grid-template-columns: repeat(2, 1fr);
  }

  .ps-gallery-item {
    position: relative;
    aspect-ratio: 3/4;
    overflow: hidden;
    background: var(--color-navy-deep);
    cursor: pointer;
    text-decoration: none;
    color: inherit;
  }

  .ps-gallery-wide {
    grid-column: span 2;
    aspect-ratio: 3/2;
  }

  .ps-img-main,
  .ps-img-hover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ps-img-hover {
    opacity: 0;
  }

  .ps-gallery-item:hover .ps-img-main {
    opacity: 0;
  }

  .ps-gallery-item:hover .ps-img-hover {
    opacity: 1;
    transform: scale(1.04);
  }

  .ps-gallery-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 0%, transparent 45%, rgba(0, 10, 39, 0.92) 100%);
    color: white;
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    z-index: 2;
    pointer-events: none;
  }

  .ps-gallery-tag {
    align-self: flex-start;
    padding: 4px 10px;
    background: var(--color-orange);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 14px;
  }

  .ps-gallery-overlay h3 {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 8px;
    letter-spacing: -0.3px;
    line-height: 1.15;
  }

  .ps-gallery-overlay p {
    font-size: 14px;
    line-height: 1.5;
    margin-bottom: 10px;
    color: rgba(255, 255, 255, 0.85);
  }

  .ps-gallery-location {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: rgba(255, 255, 255, 0.55);
  }

  /* ===== MARQUEE ===== */
  .marquee {
    background: var(--color-orange);
    padding: 16px 0;
    overflow: hidden;
    white-space: nowrap;
  }

  .marquee-content {
    display: flex;
    animation: marqueeScroll 25s linear infinite;
  }

  .marquee-item {
    display: flex;
    align-items: center;
    gap: 0;
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    color: white;
    text-transform: uppercase;
    letter-spacing: 3px;
    padding-right: 0;
    flex-shrink: 0;
  }

  .marquee-item span {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: white;
    border-radius: 50%;
    margin: 0 24px;
    opacity: 0.6;
  }

  @keyframes marqueeScroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* ===== LOCATIONS ===== */
  .locations {
    padding: 120px 40px;
    background: white;
  }

  .locations-list {
    max-width: 1200px;
    margin: 0 auto;
  }

  .location-item {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    margin-bottom: 100px;
  }

  .location-item:last-child {
    margin-bottom: 0;
  }

  .location-item.reverse {
    direction: rtl;
  }

  .location-item.reverse > * {
    direction: ltr;
  }

  .location-image {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4/3;
  }

  .location-image::after {
    content: '';
    position: absolute;
    inset: 12px;
    border: 2px solid var(--color-orange);
    pointer-events: none;
    transition: inset 0.4s var(--ease-out);
  }

  .location-item:hover .location-image::after {
    inset: 0;
  }

  .location-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }

  .location-item:hover .location-image img {
    transform: scale(1.05);
  }

  .location-number {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    color: var(--color-orange);
    letter-spacing: 2px;
    margin-bottom: 12px;
    display: block;
  }

  .location-content h3 {
    font-family: var(--font-display);
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 800;
    letter-spacing: -1px;
    color: var(--color-navy);
    margin-bottom: 16px;
  }

  .location-content p {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-gray-dark);
    margin-bottom: 20px;
  }

  .location-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 6px 14px;
    border: 1px solid var(--color-gray-light);
    color: var(--color-gray-dark);
    transition: all 0.3s;
  }

  .tag:hover {
    border-color: var(--color-orange);
    color: var(--color-orange);
  }

  /* ===== PROCESS ===== */
  .process {
    padding: 120px 40px;
    background: var(--color-bg-light);
  }

  .process-steps {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2px;
  }

  .process-step {
    background: white;
    padding: 40px;
    position: relative;
    border: 2px solid transparent;
    transition: all 0.3s var(--ease-out);
  }

  .process-step:hover {
    border-color: var(--color-orange);
  }

  .step-number {
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 900;
    color: var(--color-orange);
    line-height: 1;
    margin-bottom: 24px;
    opacity: 0.3;
  }

  .step-line {
    width: 40px;
    height: 2px;
    background: var(--color-orange);
    margin-bottom: 24px;
  }

  .process-step h3 {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 800;
    color: var(--color-navy);
    margin-bottom: 12px;
  }

  .process-step p {
    font-size: 14px;
    line-height: 1.7;
    color: var(--color-gray-dark);
  }

  /* ===== TESTIMONIALS ===== */
  .ps-testimonials-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }

  .ps-testimonial {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-left: 4px solid var(--color-orange);
    padding: 36px 36px 28px;
    margin: 0;
    position: relative;
  }

  .ps-testimonial::before {
    content: '"';
    position: absolute;
    top: -8px;
    left: 20px;
    font-family: var(--font-display);
    font-size: 80px;
    font-weight: 900;
    color: var(--color-orange);
    opacity: 0.3;
    line-height: 1;
  }

  .ps-testimonial p {
    font-size: 16px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.88);
    margin: 0 0 24px;
  }

  .ps-testimonial footer {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .ps-testimonial cite {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 700;
    font-size: 15px;
  }

  .ps-testimonial footer span {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: rgba(255, 255, 255, 0.45);
  }

  /* ===== STATS ===== */
  .stats {
    background: var(--color-navy-deep);
    padding: 80px 40px;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  .stat-number {
    font-family: var(--font-display);
    font-size: 64px;
    font-weight: 900;
    color: var(--color-orange);
    line-height: 1;
  }

  .stat-label {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-gray);
    margin-top: 8px;
  }

  /* ===== PARTNERS ===== */
  .ps-partners-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    background: rgba(255, 255, 255, 0.08);
  }

  .ps-partner {
    padding: 40px 28px;
    background: var(--color-navy-deep);
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-decoration: none;
    color: white;
    transition: background 0.3s;
  }

  .ps-partner:hover {
    background: var(--color-navy);
  }

  .ps-partner-name {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.3px;
  }

  .ps-partner-badge {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-orange);
  }

  /* ===== POLICIES ===== */
  .ps-policies-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
    background: var(--color-navy);
  }

  .ps-policy {
