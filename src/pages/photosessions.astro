---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Фотосессии на побережье Амальфи — пакеты от €200 | Atrani.ru"
  description="Киношные фотосессии на Амальфитанском побережье. Для пар, путешественников и блогеров. Съёмка с местным фотографом в Атрани, Амальфи, Равелло, Позитано. Пакеты от €200."
  ogImage="/images/photosessions/regan-tay-main.webp"
>
  <!-- Hero -->
  <section class="hero ps-hero">
    <div class="ps-hero-slideshow" aria-hidden="true">
      <img src="/images/photosessions/hero-atrani.webp" alt="" class="ps-slide is-active" data-caption="Атрани">
      <img src="/images/photosessions/hero-ravello.webp" alt="" class="ps-slide" data-caption="Равелло">
      <img src="/images/photosessions/hero-amalfi.jpg" alt="" class="ps-slide" data-caption="Амальфи">
      <img src="/images/photosessions/hero-tramonti.webp" alt="" class="ps-slide" data-caption="Трамонти">
    </div>

    <div class="hero-content ps-hero-content">
      <div class="ps-hero-actions">
        <a href="#pakety" class="ps-hero-btn ps-hero-btn-primary">
          <span class="ps-hero-btn-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter"><path d="M3 7l9-4 9 4v10l-9 4-9-4V7z"/><path d="M3 7l9 4 9-4"/><path d="M12 11v10"/></svg>
          </span>
          <span class="ps-hero-btn-text">Выбрать пакет</span>
        </a>
        <a href="/contacts#contact-form" class="ps-hero-btn ps-hero-btn-outline">
          <span class="ps-hero-btn-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter"><rect x="3" y="5" width="18" height="14"/><path d="M3 7l9 6 9-6"/></svg>
          </span>
          <span class="ps-hero-btn-text">Написать</span>
        </a>
      </div>
      <div class="ps-hero-tags">
        <span class="ps-hero-tag">
          <span class="ps-hero-tag-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter"><path d="M12 21s-7-4.5-7-11a4 4 0 017-2.5A4 4 0 0119 10c0 6.5-7 11-7 11z"/></svg>
          </span>
          <span class="ps-hero-tag-text">Пары</span>
        </span>
        <span class="ps-hero-tag">
          <span class="ps-hero-tag-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1c0-4 4-6 8-6s8 2 8 6v1"/></svg>
          </span>
          <span class="ps-hero-tag-text">Соло-портрет</span>
        </span>
        <span class="ps-hero-tag">
          <span class="ps-hero-tag-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter"><rect x="3" y="7" width="18" height="13"/><path d="M8 7l2-3h4l2 3"/><circle cx="12" cy="13" r="3.5"/></svg>
          </span>
          <span class="ps-hero-tag-text">Блогеры</span>
        </span>
        <span class="ps-hero-tag">
          <span class="ps-hero-tag-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </span>
          <span class="ps-hero-tag-text">Золотой час</span>
        </span>
        <span class="ps-hero-tag">
          <span class="ps-hero-tag-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter"><rect x="3" y="4" width="18" height="16"/><path d="M3 8h2M3 12h2M3 16h2M19 8h2M19 12h2M19 16h2M8 4v16M16 4v16"/></svg>
          </span>
          <span class="ps-hero-tag-text">Киношный стиль</span>
        </span>
        <span class="ps-hero-tag">
          <span class="ps-hero-tag-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter"><path d="M12 22s-8-7.58-8-13a8 8 0 0116 0c0 5.42-8 13-8 13z"/><circle cx="12" cy="9" r="2.5"/></svg>
          </span>
          <span class="ps-hero-tag-text">Скрытые места</span>
        </span>
      </div>
    </div>
  </section>

  <!-- Packages -->
  <section class="ps-section" id="pakety">
    <div class="section-header reveal">
      <p class="section-label">01 — Пакеты съёмок</p>
      <h2 class="section-title">Четыре сценария —<br>одна Италия</h2>
    </div>

    <div class="ps-packages-grid">
      <!-- Solo 1 -->
      <article class="ps-package reveal">
        <div class="ps-package-tag">Соло</div>
        <h3 class="ps-package-title">Портрет путешественника</h3>
        <div class="ps-package-price">
          <span class="ps-price-amount">€200</span>
          <span class="ps-price-meta">≈ 45 минут</span>
        </div>
        <ul class="ps-package-list">
          <li>2 локации в Атрани</li>
          <li>25+ обработанных фото</li>
          <li>Утро или золотой час</li>
          <li>Форматы под Instagram и LinkedIn</li>
          <li>Онлайн-галерея — 7 рабочих дней</li>
        </ul>
        <p class="ps-package-for">Для соло-путешественников, создателей контента, деловых портретов на выезде.</p>
      </article>

      <!-- Solo 2 — Popular -->
      <article class="ps-package ps-package-featured reveal">
        <div class="ps-package-ribbon">Популярный</div>
        <div class="ps-package-tag">Блогер</div>
        <h3 class="ps-package-title">Истории побережья</h3>
        <div class="ps-package-price">
          <span class="ps-price-amount">€320</span>
          <span class="ps-price-meta">≈ 1,5 часа</span>
        </div>
        <ul class="ps-package-list">
          <li>3–4 локации: Атрани и окрестности</li>
          <li>50+ обработанных фото</li>
          <li>3 чёрно-белых варианта</li>
          <li>Экспресс-превью (3 фото за 24 часа)</li>
          <li>Скрытые места вне туристических троп</li>
          <li>Онлайн-галерея — 7 рабочих дней</li>
        </ul>
        <p class="ps-package-for">Для блогеров, тревел-авторов, подарка себе на день рождения, контента в портфолио.</p>
      </article>

      <!-- Couple 1 -->
      <article class="ps-package reveal">
        <div class="ps-package-tag">Пара</div>
        <h3 class="ps-package-title">Золотой час в Атрани</h3>
        <div class="ps-package-price">
          <span class="ps-price-amount">€280</span>
          <span class="ps-price-meta">≈ 1 час</span>
        </div>
        <ul class="ps-package-list">
          <li>2–3 локации в Атрани</li>
          <li>40+ обработанных фото</li>
          <li>Рассвет или закат — золотой свет</li>
          <li>Консультация по образу</li>
          <li>Онлайн-галерея — 7 рабочих дней</li>
        </ul>
        <p class="ps-package-for">Для медового месяца, годовщины, романтического уикенда, save-the-date.</p>
      </article>

      <!-- Couple 2 — Best Value -->
      <article class="ps-package ps-package-featured reveal">
        <div class="ps-package-ribbon">Лучшее предложение</div>
        <div class="ps-package-tag">Пара</div>
        <h3 class="ps-package-title">Панорама двух городков</h3>
        <div class="ps-package-price">
          <span class="ps-price-amount">€400</span>
          <span class="ps-price-meta">≈ 2 часа</span>
        </div>
        <ul class="ps-package-list">
          <li>4–6 локаций: Атрани + Амальфи</li>
          <li>80+ обработанных фото</li>
          <li>5 чёрно-белых вариантов</li>
          <li>Экспресс-превью (3–5 фото за 24 часа)</li>
          <li>И живой кадр на ходу, и классическая поза</li>
          <li>Онлайн-галерея — 7 рабочих дней</li>
        </ul>
        <p class="ps-package-for">Для помолвки, proposal, побега-свадьбы, годовщины, больших соцсетей.</p>
      </article>
    </div>

    <div class="ps-package-cta reveal">
      <a href="/contacts#contact-form" class="btn btn-primary">Забронировать сессию</a>
      <a href="https://wa.me/393270972329" target="_blank" rel="noopener" class="btn btn-outline">Спросить в WhatsApp</a>
    </div>
  </section>

  <!-- What's Included -->
  <section class="ps-section ps-included">
    <div class="section-header reveal">
      <p class="section-label">02 — Включено в каждую сессию</p>
      <h2 class="section-title">Без звёздочек<br>и мелкого шрифта</h2>
    </div>

    <div class="ps-included-grid">
      <div class="ps-included-item reveal">
        <div class="ps-included-num">01</div>
        <h3>Консультация до съёмки</h3>
        <p>Созвон или переписка в WhatsApp — обсудим настроение, образ, места. Никаких сюрпризов в день съёмки.</p>
      </div>
      <div class="ps-included-item reveal">
        <div class="ps-included-num">02</div>
        <h3>Профессиональная ретушь</h3>
        <p>Цветокоррекция, аккуратная работа с кожей, киношный колор. Каждый кадр доведён до финальной версии.</p>
      </div>
      <div class="ps-included-item reveal">
        <div class="ps-included-num">03</div>
        <h3>Фото в полном разрешении</h3>
        <p>JPEG в максимальном качестве — хоть печатать 60×90, хоть выкладывать в сторис.</p>
      </div>
      <div class="ps-included-item reveal">
        <div class="ps-included-num">04</div>
        <h3>Локации от местного</h3>
        <p>Проведу по тихим улочкам, террасам с видом и углам, которые не достать по Google. Знаю, во сколько туда приходит свет.</p>
      </div>
      <div class="ps-included-item reveal">
        <div class="ps-included-num">05</div>
        <h3>Направляю по ходу</h3>
        <p>Никакого «постойте здесь неловко». Подскажу, куда повернуть голову, чем занять руки — чтобы получилось живо.</p>
      </div>
      <div class="ps-included-item reveal">
        <div class="ps-included-num">06</div>
        <h3>Онлайн-галерея</h3>
        <p>Закрытая ссылка с доступом на 90 дней. Скачивайте сами, делитесь с родителями и друзьями.</p>
      </div>
    </div>
  </section>

  <!-- Travel Zones -->
  <section class="ps-section ps-zones">
    <div class="section-header reveal">
      <p class="section-label">03 — Выезд в другие городки</p>
      <h2 class="section-title">Куда можем<br>доехать</h2>
    </div>

    <div class="ps-zones-table reveal">
      <div class="ps-zone-row ps-zone-head">
        <div>Зона</div>
        <div>Города</div>
        <div>Доплата</div>
      </div>
      <div class="ps-zone-row">
        <div class="ps-zone-label">База</div>
        <div>Атрани, Амальфи</div>
        <div class="ps-zone-price">включено</div>
      </div>
      <div class="ps-zone-row">
        <div class="ps-zone-label">Зона 1</div>
        <div>Равелло, Минори, Майори</div>
        <div class="ps-zone-price">+€30</div>
      </div>
      <div class="ps-zone-row">
        <div class="ps-zone-label">Зона 2</div>
        <div>Четара, Виетри-суль-Маре, Трамонти, Скала</div>
        <div class="ps-zone-price">+€50</div>
      </div>
      <div class="ps-zone-row">
        <div class="ps-zone-label">Зона 3</div>
        <div>Позитано, Прайано, Фуроре</div>
        <div class="ps-zone-price">+€70</div>
      </div>
      <div class="ps-zone-row">
        <div class="ps-zone-label">Зона 4</div>
        <div>Сорренто, Салерно</div>
        <div class="ps-zone-price">+€100</div>
      </div>
      <div class="ps-zone-row">
        <div class="ps-zone-label">Зона 5</div>
        <div>Капри, Неаполь, Помпеи</div>
        <div class="ps-zone-price">+€150 + транспорт</div>
      </div>
    </div>

    <p class="ps-zones-note reveal">Время дороги не съедает вашу съёмку. Для 3–5 зон минимум — 1,5 часа. Если бронируете 2+ часа в зонах 1–2, доплата за выезд сокращается в два раза.</p>
  </section>

  <!-- Add-ons -->
  <section class="ps-section">
    <div class="section-header reveal">
      <p class="section-label">04 — Дополнения</p>
      <h2 class="section-title">Что можно<br>добавить</h2>
    </div>

    <div class="ps-addons-grid">
      <div class="ps-addon reveal">
        <span class="ps-addon-price">+€60</span>
        <h3>Срочная доставка</h3>
        <p>Все обработанные фото за 48 часов вместо недели.</p>
      </div>
      <div class="ps-addon reveal">
        <span class="ps-addon-price">+€25</span>
        <h3>Экспресс-превью</h3>
        <p>5 лёгко отредактированных кадров через 12 часов после съёмки.</p>
      </div>
      <div class="ps-addon reveal">
        <span class="ps-addon-price">+€40</span>
        <h3>Полный чёрно-белый сет</h3>
        <p>Весь пакет дополнительно в чёрно-белой версии.</p>
      </div>
      <div class="ps-addon reveal">
        <span class="ps-addon-price">+€120/час</span>
        <h3>Дополнительное время</h3>
        <p>Продлить любую сессию на час сверху.</p>
      </div>
      <div class="ps-addon reveal">
        <span class="ps-addon-price">+€80</span>
        <h3>RAW-файлы</h3>
        <p>Исходники без обработки — если хотите свой колор.</p>
      </div>
      <div class="ps-addon reveal">
        <span class="ps-addon-price">+€120</span>
        <h3>Эксклюзивные права</h3>
        <p>Фото не пойдут в моё портфолио и соцсети — только ваши.</p>
      </div>
      <div class="ps-addon reveal">
        <span class="ps-addon-price">+€50</span>
        <h3>Комплект принтов</h3>
        <p>10 архивных отпечатков 13×18 см — как открытки или для рамок.</p>
      </div>
      <div class="ps-addon reveal">
        <span class="ps-addon-price">+€70</span>
        <h3>Слайдшоу-ролик</h3>
        <p>60-секундное видео с лучшими кадрами и музыкой.</p>
      </div>
      <div class="ps-addon reveal">
        <span class="ps-addon-price">+€30/чел</span>
        <h3>Дополнительный человек</h3>
        <p>Если приехала подруга, ребёнок или собака — присоединяются без проблем.</p>
      </div>
    </div>

    <p class="ps-addons-note reveal">В праздники (Рождество, Новый год, Пасха, 15 августа) доплата +20%.</p>
  </section>

  <!-- Seasons -->
  <section class="ps-section ps-seasons">
    <div class="section-header reveal">
      <p class="section-label">05 — Сезоны и скидки</p>
      <h2 class="section-title">Когда<br>приезжать</h2>
    </div>

    <div class="ps-seasons-grid">
      <article class="ps-season reveal">
        <div class="ps-season-head">
          <h3>Высокий сезон</h3>
          <span class="ps-season-months">июнь — сентябрь</span>
        </div>
        <p class="ps-season-price">Стандартная цена</p>
        <p class="ps-season-desc">Бронируйте за 2–4 недели. Рассветные сессии — чтобы обойти толпу и поймать тихое побережье.</p>
      </article>

      <article class="ps-season ps-season-featured reveal">
        <div class="ps-season-badge">−20%</div>
        <div class="ps-season-head">
          <h3>Средний сезон</h3>
          <span class="ps-season-months">апрель — май, октябрь</span>
        </div>
        <p class="ps-season-price">Акция 2026: минус 20%</p>
        <p class="ps-season-desc">Лучший свет, минимум туристов. Идеальный баланс для неспешной, киношной съёмки — можно выдохнуть и не торопиться.</p>
      </article>

      <article class="ps-season ps-season-featured reveal">
        <div class="ps-season-badge">−15%</div>
        <div class="ps-season-head">
          <h3>Низкий сезон</h3>
          <span class="ps-season-months">ноябрь — март</span>
        </div>
        <p class="ps-season-price">Минус 15% + 10 бонусных фото</p>
        <p class="ps-season-desc">Драматическое небо, зимнее море, пустые улицы. Совсем другая Амальфи — со своей тишиной и характером.</p>
      </article>
    </div>

    <p class="ps-seasons-loyalty reveal">Вернувшимся клиентам — скидка 10% на следующую сессию. Приведёте друга — вам обоим по €30 скидки.</p>
  </section>

  <!-- Individual Portfolio -->
  <section class="ps-section ps-portfolio">
    <div class="section-header reveal">
      <p class="section-label">06 — Портфолио: соло</p>
      <h2 class="section-title">Индивидуальные<br>съёмки</h2>
    </div>

    <div class="ps-gallery">
      <a href="/photosessions/shifa" class="ps-gallery-item reveal">
        <img src="/images/photosessions/shifa-main.webp" alt="Фотосессия блогера в Амальфи — Шифа" loading="lazy" class="ps-img-main">
        <img src="/images/photosessions/shifa-hover.webp" alt="" loading="lazy" class="ps-img-hover" aria-hidden="true">
        <div class="ps-gallery-overlay">
          <span class="ps-gallery-tag">Блогер</span>
          <h3>Амальфи днём</h3>
          <p>Смелые позы, солнечные улицы и контент, на котором залипают.</p>
          <span class="ps-gallery-location">Амальфи</span>
        </div>
      </a>

      <a href="/photosessions/loreana" class="ps-gallery-item reveal">
        <img src="/images/photosessions/loreana-main.webp" alt="Фотосессия в Равелло — Лореана" loading="lazy" class="ps-img-main">
        <img src="/images/photosessions/loreana-hover.webp" alt="" loading="lazy" class="ps-img-hover" aria-hidden="true">
        <div class="ps-gallery-overlay">
          <span class="ps-gallery-tag">Личная</span>
          <h3>Подарок самой себе</h3>
          <p>Одинокий побег по садам Равелло, террасы, золотой час.</p>
          <span class="ps-gallery-location">Равелло</span>
        </div>
      </a>

      <a href="/photosessions/lashada" class="ps-gallery-item reveal">
        <img src="/images/photosessions/lashada-main.webp" alt="Утренняя фотосессия в Атрани — Лашанда" loading="lazy" class="ps-img-main">
        <img src="/images/photosessions/lashada-hover.webp" alt="" loading="lazy" class="ps-img-hover" aria-hidden="true">
        <div class="ps-gallery-overlay">
          <span class="ps-gallery-tag">Личная</span>
          <h3>Утренний свет. Настоящий Атрани</h3>
          <p>Первые лучи на пастельных стенах — пока мир ещё спит.</p>
          <span class="ps-gallery-location">Атрани</span>
        </div>
      </a>

      <a href="/photosessions/julietta" class="ps-gallery-item reveal">
        <img src="/images/photosessions/julietta-main.webp" alt="Фотосессия в Майори — Джулиетта" loading="lazy" class="ps-img-main">
        <img src="/images/photosessions/julietta-hover.webp" alt="" loading="lazy" class="ps-img-hover" aria-hidden="true">
        <div class="ps-gallery-overlay">
          <span class="ps-gallery-tag">Личная</span>
          <h3>Подарочный закат</h3>
          <p>Тёплые тона, лесные тропы — золотой свет, упакованный как подарок.</p>
          <span class="ps-gallery-location">Майори</span>
        </div>
      </a>

      <a href="/photosessions/ravello-photoshooting" class="ps-gallery-item ps-gallery-wide reveal">
        <img src="/images/photosessions/ravello-editorial-main.webp" alt="Редакторская съёмка в Равелло" loading="lazy" class="ps-img-main">
