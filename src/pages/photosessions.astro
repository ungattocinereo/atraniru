<script>
  // Hero slideshow rotation
  const slides = document.querySelectorAll<HTMLImageElement>('.ps-slide');
  if (slides.length > 1) {
    let current = 0;
    setInterval(() => {
      slides[current].classList.remove('is-active');
      current = (current + 1) % slides.length;
      slides[current].classList.add('is-active');
    }, 4500);
  }
</script>
